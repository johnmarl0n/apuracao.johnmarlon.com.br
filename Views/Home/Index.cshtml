@model apuracao.johnmarlon.com.br.Models.ApuracaoViewModel
@functions {
    bool FotoExiste(string? numero)
    {
        if (string.IsNullOrWhiteSpace(numero)) return false;
        var p1 = System.IO.Path.Combine(System.AppContext.BaseDirectory, "wwwroot", "img", "candidatos", $"{numero}.jpg");
        var p2 = System.IO.Path.Combine(System.IO.Directory.GetCurrentDirectory(), "wwwroot", "img", "candidatos", $"{numero}.jpg");
        return System.IO.File.Exists(p1) || System.IO.File.Exists(p2);
    }
}
@{
    ViewData["Title"] = $"Apuração 2º Turno - {Model.CargoNome} {Model.Ano}";
    var cand1 = Model.Candidatos.Count > 0 ? Model.Candidatos[0] : null;
    var cand2 = Model.Candidatos.Count > 1 ? Model.Candidatos[1] : null;
    long diffVotos = (cand1 != null && cand2 != null) ? Math.Abs(cand1.Votos - cand2.Votos) : 0;
    bool cand1Lider = cand1 != null && (cand2 == null || cand1.Votos >= cand2.Votos);
    string cor1 = cand1?.CorPartido ?? "#c4122d";
    string cor2 = cand2?.CorPartido ?? "#2563eb";
}

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <style>
        .font-display {
            font-family: 'Outfit', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            letter-spacing: -0.03em;
        }

        .font-serif-headline {
            font-family: 'Georgia', 'Times New Roman', serif;
            font-weight: 700;
            letter-spacing: -0.02em;
            line-height: 1.15;
        }

        .cand-headline-name-c1 {
            color: var(--cand1-text-color);
        }

        .cand-headline-name-c2 {
            color: var(--cand2-text-color);
        }

        .cand-headline-connector {
            color: var(--text-title);
        }

        .leaflet-tooltip-dark {
            background: rgba(11, 15, 25, 0.94) !important;
            border: 1px solid rgba(56, 189, 248, 0.45) !important;
            border-radius: 8px !important;
            padding: 8px 12px !important;
            color: #ffffff !important;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.8) !important;
            backdrop-filter: blur(10px) !important;
        }

        .filter-chip {
            background: var(--chip-bg);
            border: 1px solid var(--chip-border);
            color: var(--chip-text);
            padding: 0.4rem 0.85rem;
            border-radius: 9999px;
            text-decoration: none;
            font-size: 0.8rem;
            font-weight: 500;
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            transition: all 0.2s ease;
            white-space: nowrap;
        }

        .filter-chip:hover {
            background: var(--primary);
            color: #ffffff !important;
            border-color: var(--primary);
        }

        .filter-chip.active {
            background: var(--primary);
            color: #ffffff !important;
            border-color: var(--primary-light);
            box-shadow: 0 0 12px rgba(37, 99, 235, 0.45);
        }

        .quick-loc-pill {
            background: var(--chip-bg);
            border: 1px solid var(--border-card-subtle);
            color: var(--chip-text);
            padding: 0.22rem 0.65rem;
            border-radius: 9999px;
            font-size: 0.74rem;
            font-weight: 500;
            display: inline-flex;
            align-items: center;
            gap: 0.25rem;
            transition: all 0.15s ease;
            cursor: pointer;
            line-height: 1.25;
            white-space: nowrap;
        }

        .quick-loc-pill:hover {
            background: rgba(37, 99, 235, 0.12);
            border-color: rgba(59, 130, 246, 0.4);
            color: var(--text-title);
        }

        .quick-loc-pill.active {
            background: rgba(37, 99, 235, 0.18);
            border-color: var(--primary);
            color: var(--primary);
            font-weight: 600;
        }

        /* Card Duelo Presidencial */
        .duel-side-card {
            background: var(--bg-card);
            border: 1px solid var(--border-card);
            border-radius: 1rem;
            box-shadow: var(--card-shadow);
            color: var(--text-main);
        }

        .cand-square-avatar {
            width: 52px;
            height: 52px;
            border-radius: 0.65rem;
            object-fit: cover;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 1.25rem;
            color: #ffffff;
            flex-shrink: 0;
            overflow: hidden;
        }

        .cand-percent-display {
            color: var(--text-title);
            line-height: 1;
        }

        .cand-title-name {
            color: var(--text-title);
        }

        .duel-split-bar {
            height: 8px;
            background: var(--border-card-subtle);
            border-radius: 9999px;
            position: relative;
            display: flex;
            overflow: visible;
        }

        .threshold-50-marker {
            position: absolute;
            left: 50%;
            top: -4px;
            bottom: -4px;
            width: 2px;
            background: var(--text-title);
            box-shadow: 0 0 8px var(--text-title);
            z-index: 10;
        }

        /* Gráfico "Ao longo da apuração" */
        .chart-box {
            background: var(--bg-card-subtle);
            border: 1px solid var(--border-card-subtle);
            border-radius: 0.85rem;
            padding: 0.85rem;
        }

        /* Sidebar Regiões e Feed */
        .sidebar-card {
            background: var(--bg-card);
            border: 1px solid var(--border-card);
            border-radius: 1rem;
            box-shadow: var(--card-shadow);
            color: var(--text-main);
        }

        /* Região Row v2 (Estilo seuimposto.com) */
        .region-row-v2 {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0.5rem 0;
            border-bottom: 1px solid var(--border-card-subtle);
            gap: 6px;
        }
        .region-row-v2:last-child {
            border-bottom: none;
            padding-bottom: 0;
        }
        .region-info {
            display: flex;
            flex-direction: column;
            gap: 1px;
            min-width: 0;
            flex-shrink: 0;
        }
        .region-title {
            font-size: 0.85rem;
            font-weight: 700;
            color: var(--text-title);
            line-height: 1.2;
            white-space: nowrap;
        }
        .region-sub {
            font-size: 0.68rem;
            color: var(--text-secondary);
            white-space: nowrap;
        }
        .region-stats {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: 2px;
            flex-shrink: 0;
        }
        .region-cand-pill {
            display: flex;
            align-items: center;
            gap: 6px;
            white-space: nowrap;
        }
        .region-avatar {
            width: 22px;
            height: 22px;
            border-radius: 50%;
            object-fit: cover;
            border: 1px solid rgba(255, 255, 255, 0.15);
            background: #2563eb;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 0.6rem;
            font-weight: bold;
            color: #ffffff;
            flex-shrink: 0;
        }
        .region-party {
            font-size: 0.72rem;
            font-weight: 800;
            white-space: nowrap;
        }
        .region-party-pl {
            color: #3b82f6;
        }
        .region-party-pt {
            color: #ef4444;
        }
        .region-pct {
            font-size: 0.82rem;
            font-weight: 800;
            font-family: var(--font-mono, monospace);
            color: var(--text-title);
            white-space: nowrap;
        }
        .region-diff {
            font-size: 0.7rem;
            font-family: var(--font-mono, monospace);
            color: var(--text-secondary);
            white-space: nowrap;
        }

        /* Mini-Barra de Vantagem / Duel Bar */
        .mini-duel-bar-wrap {
            width: 58px;
            height: 3px;
            background: rgba(255, 255, 255, 0.15);
            border-radius: 9999px;
            position: relative;
            margin-top: 2px;
        }
        .mini-duel-tick {
            position: absolute;
            left: 50%;
            top: -2px;
            bottom: -2px;
            width: 1px;
            background: var(--text-title);
            opacity: 0.55;
            z-index: 2;
        }
        .mini-duel-fill {
            position: absolute;
            height: 100%;
            border-radius: 9999px;
            top: 0;
        }

        /* Container de Notícias com Efeito Esmaecido (Gradient Mask) e sem Rollover */
        .news-feed-fade-container {
            max-height: 390px;
            overflow-y: auto;
            scrollbar-width: none; /* Firefox */
            -ms-overflow-style: none; /* IE e Edge */
            -webkit-mask-image: linear-gradient(180deg, rgba(0,0,0,1) 0%, rgba(0,0,0,1) 68%, rgba(0,0,0,0) 100%);
            mask-image: linear-gradient(180deg, rgba(0,0,0,1) 0%, rgba(0,0,0,1) 68%, rgba(0,0,0,0) 100%);
            padding-bottom: 24px;
        }
        .news-feed-fade-container::-webkit-scrollbar {
            display: none; /* Chrome, Safari, Edge */
        }

        /* Notícia Item v2 */
        .news-row-v2 {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            padding: 0.65rem 0;
            border-bottom: 1px solid var(--border-card-subtle);
        }
        .news-row-v2:last-child {
            border-bottom: none;
        }
        .news-time {
            font-size: 0.72rem;
            font-family: var(--font-mono, monospace);
            color: var(--text-secondary);
            min-width: 38px;
            flex-shrink: 0;
            padding-top: 3px;
        }
        .news-avatar {
            width: 26px;
            height: 26px;
            border-radius: 50%;
            object-fit: cover;
            border: 1px solid rgba(255, 255, 255, 0.15);
            flex-shrink: 0;
        }
        .news-icon-circle {
            width: 26px;
            height: 26px;
            border-radius: 50%;
            border: 1.5px solid var(--text-secondary);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: var(--text-title);
            font-size: 0.7rem;
            flex-shrink: 0;
            background: transparent;
        }
        .news-body {
            font-size: 0.79rem;
            line-height: 1.35;
            color: var(--text-main);
            overflow-wrap: break-word;
            word-break: normal;
        }
        .news-body strong {
            color: var(--text-title);
            font-weight: 600;
        }

        /* Regras explícitas de alto contraste para o Dark Mode */
        [data-theme="dark"] .sidebar-card {
            background: #10141d !important;
            border-color: rgba(255, 255, 255, 0.08) !important;
            color: #f1f5f9 !important;
        }
        [data-theme="dark"] .sidebar-card span[style*="var(--text-title)"],
        [data-theme="dark"] .sidebar-card .small.fw-bold,
        [data-theme="dark"] .region-title,
        [data-theme="dark"] .region-pct {
            color: #ffffff !important;
        }
        [data-theme="dark"] .sidebar-card .text-secondary,
        [data-theme="dark"] .region-sub,
        [data-theme="dark"] .region-diff,
        [data-theme="dark"] .news-time {
            color: #94a3b8 !important;
        }
        [data-theme="dark"] .mini-duel-bar-wrap {
            background: rgba(255, 255, 255, 0.14) !important;
        }
        [data-theme="dark"] .mini-duel-tick {
            background: #ffffff !important;
        }
        [data-theme="dark"] .news-body {
            color: #e2e8f0 !important;
        }
        [data-theme="dark"] .news-body strong {
            color: #ffffff !important;
        }

        /* Regras explícitas de alto contraste para o Light Mode */
        [data-theme="light"] .sidebar-card {
            background: #ffffff !important;
            border-color: #e2e8f0 !important;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06) !important;
            color: #1e293b !important;
        }
        [data-theme="light"] .sidebar-card span[style*="var(--text-title)"],
        [data-theme="light"] .sidebar-card .small.fw-bold,
        [data-theme="light"] .region-title,
        [data-theme="light"] .region-pct {
            color: #0f172a !important;
        }
        [data-theme="light"] .sidebar-card .text-secondary,
        [data-theme="light"] .region-sub,
        [data-theme="light"] .region-diff,
        [data-theme="light"] .news-time {
            color: #64748b !important;
        }
        [data-theme="light"] .mini-duel-bar-wrap {
            background: rgba(0, 0, 0, 0.12) !important;
        }
        [data-theme="light"] .mini-duel-tick {
            background: #0f172a !important;
        }
        [data-theme="light"] .news-body {
            color: #1e293b !important;
        }
        [data-theme="light"] .news-body strong {
            color: #0f172a !important;
        }

        /* Countdown Compacto */
        .countdown-strip {
            background: linear-gradient(135deg, rgba(30, 41, 59, 0.7) 0%, rgba(15, 23, 42, 0.85) 100%);
            border: 1px solid var(--border-card);
            border-radius: 0.75rem;
        }

        .border-themed {
            border-color: var(--border-card-subtle) !important;
        }

        /* Altura adaptativa do Mapa Leaflet para preencher a tela inteira */
        .mapa-leaflet-frame {
            height: 480px;
            width: 100%;
            z-index: 10;
        }

        /* Proporções customizadas do Dashboard para uso total da altura do viewport sem scroll */
        @@media (min-width: 992px) {
            .dashboard-localidade-bar {
                margin-bottom: 0.15rem !important;
                min-height: 28px !important;
                flex-shrink: 0 !important;
            }
            .dashboard-localidade-bar .filter-chip {
                padding: 0.16rem 0.55rem !important;
                font-size: 0.72rem !important;
                line-height: 1.2 !important;
            }
            .dashboard-layout-row {
                display: flex !important;
                flex-wrap: nowrap !important;
                align-items: stretch !important;
                gap: 0.55rem !important;
                flex: 1 1 0% !important;
                min-height: 0 !important;
                height: auto !important;
                max-height: 100% !important;
                margin: 0 !important;
                padding-bottom: 0.45rem !important;
                overflow: hidden !important;
            }
            .dashboard-layout-row > [class*="dashboard-col-"] {
                padding-left: 0 !important;
                padding-right: 0 !important;
                padding-top: 0 !important;
            }
            .dashboard-col-left {
                display: flex !important;
                flex-direction: column !important;
                flex: 0 0 26% !important;
                max-width: 26% !important;
                width: 26% !important;
                height: 100% !important;
                max-height: 100% !important;
                min-height: 0 !important;
                overflow: hidden !important;
            }
            .dashboard-col-center {
                display: flex !important;
                flex-direction: column !important;
                flex: 1 1 0% !important;
                max-width: none !important;
                width: auto !important;
                height: 100% !important;
                max-height: 100% !important;
                min-height: 0 !important;
                overflow: hidden !important;
            }
            .dashboard-col-right {
                display: flex !important;
                flex-direction: column !important;
                flex: 0 0 27% !important;
                max-width: 27% !important;
                width: 27% !important;
                height: 100% !important;
                max-height: 100% !important;
                min-height: 0 !important;
                overflow: hidden !important;
            }

            /* Coluna Esquerda: Card Duelo enxuto e Gráfico estendido até o final */
            .dashboard-col-left .duel-side-card {
                flex-shrink: 0 !important;
                margin-bottom: 0.25rem !important;
                padding: 0.45rem 0.65rem !important;
            }
            .dashboard-col-left .cand-square-avatar {
                width: 34px !important;
                height: 34px !important;
                border-radius: 0.45rem !important;
                font-size: 0.95rem !important;
            }
            .dashboard-col-left .font-serif-headline {
                font-size: 0.92rem !important;
                margin-bottom: 0.25rem !important;
            }
            .dashboard-col-left .cand-percent-display {
                font-size: 1.55rem !important;
            }
            .dashboard-col-left .duel-split-bar {
                height: 6px !important;
                margin-bottom: 0.25rem !important;
            }
            .dashboard-col-left .card-ao-longo-apuracao {
                flex: 1 1 0 !important;
                min-height: 0 !important;
                display: flex !important;
                flex-direction: column !important;
                margin-bottom: 0 !important;
                padding: 0.35rem 0.65rem !important;
                overflow: hidden !important;
            }
            .dashboard-col-left .card-ao-longo-apuracao .chart-box {
                flex: 1 1 0 !important;
                min-height: 0 !important;
                display: flex !important;
                align-items: stretch !important;
                overflow: hidden !important;
                padding: 0.15rem !important;
            }

            /* Coluna Centro: Mapa esticado dinamicamente entre filtro e scrubber */
            #boxMapaBrasil {
                height: 100% !important;
                display: flex !important;
                flex-direction: column !important;
                min-height: 0 !important;
                gap: 0.25rem !important;
                overflow: hidden !important;
            }
            .map-wrapper-leaflet {
                flex: 1 1 0% !important;
                min-height: 0 !important;
                height: 0 !important;
                display: flex !important;
                flex-direction: column !important;
            }
            .mapa-leaflet-frame {
                flex: 1 1 0% !important;
                height: 100% !important;
                min-height: 0 !important;
                width: 100% !important;
            }
            .timeline-bar-box {
                flex-shrink: 0 !important;
                height: 36px !important;
                min-height: 36px !important;
                margin-bottom: 0 !important;
            }

            /* Coluna Direita: Por Região enxuto e Feed ocupando o resto com gradiente */
            .dashboard-col-right .sidebar-card-regions {
                flex-shrink: 0 !important;
                margin-bottom: 0.25rem !important;
                padding: 0.45rem 0.75rem !important;
            }
            .dashboard-col-right .region-row-v2 {
                padding: 2px 0 !important;
            }
            .dashboard-col-right .sidebar-card-feed {
                flex: 1 1 0 !important;
                min-height: 0 !important;
                display: flex !important;
                flex-direction: column !important;
                margin-bottom: 0 !important;
                padding: 0.45rem 0.75rem !important;
                overflow: hidden !important;
            }
            .dashboard-col-right .news-feed-fade-container {
                flex: 1 1 0 !important;
                min-height: 0 !important;
                height: 100% !important;
                max-height: none !important;
                overflow-y: hidden !important;
            }
            .dashboard-col-right .news-row-v2 {
                padding: 0.25rem 0 !important;
            }
        }

        @@media (min-width: 1200px) {
            .dashboard-col-left {
                flex: 0 0 24.5% !important;
                max-width: 24.5% !important;
                width: 24.5% !important;
            }
            .dashboard-col-center {
                flex: 1 1 0% !important;
                max-width: none !important;
                width: auto !important;
            }
            .dashboard-col-right {
                flex: 0 0 26% !important;
                max-width: 26% !important;
                width: 26% !important;
            }
        }

        @@media (min-width: 1600px) {
            .dashboard-col-left {
                flex: 0 0 22% !important;
                max-width: 22% !important;
                width: 22% !important;
            }
            .dashboard-col-center {
                flex: 1 1 0% !important;
                max-width: none !important;
                width: auto !important;
            }
            .dashboard-col-right {
                flex: 0 0 24% !important;
                max-width: 24% !important;
                width: 24% !important;
            }
        }
    </style>
}

<!-- Navegação e Filtro Rápido de Localidade (Drill-down Brasil -> SP -> Cidades) -->
<div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2 dashboard-localidade-bar">
    <div class="d-flex align-items-center flex-wrap gap-2" id="barraLocalidadesContainer">
        <span class="text-secondary small fw-bold text-uppercase me-1">
            <i class="bi bi-geo-alt-fill text-primary"></i> Localidade:
        </span>

        <a href="?ano=@Model.Ano&cargo=@Model.CargoCodigo&uf=br" 
           class="filter-chip @(Model.Uf == "br" && string.IsNullOrEmpty(Model.CodigoMunicipio) ? "active" : "")">
            <i class="bi bi-globe-americas"></i> Brasil (Total)
        </a>

        <a href="?ano=@Model.Ano&cargo=@Model.CargoCodigo&uf=sp" 
           class="filter-chip @(Model.Uf == "sp" && string.IsNullOrEmpty(Model.CodigoMunicipio) ? "active" : "")">
            <i class="bi bi-map-fill"></i> Estado de São Paulo
        </a>

        <a href="?ano=@Model.Ano&cargo=@Model.CargoCodigo&uf=sp&municipio=62910" 
           class="filter-chip @(Model.CodigoMunicipio == "62910" ? "active" : "")">
            <i class="bi bi-pin-map-fill text-warning"></i> Campinas / SP
        </a>

        @if (!string.IsNullOrEmpty(Model.CodigoMunicipio) && Model.CodigoMunicipio != "62910")
        {
            <div class="filter-chip active d-flex align-items-center gap-2">
                <i class="bi bi-building"></i>
                <span id="lblNomeCidadeAtual">@(Model.NomeMunicipio ?? Model.CodigoMunicipio)</span>
                <a href="?ano=@Model.Ano&cargo=@Model.CargoCodigo&uf=@Model.Uf" class="text-white text-decoration-none ms-1" title="Remover filtro">
                    <i class="bi bi-x-circle-fill"></i>
                </a>
            </div>
        }
    </div>

    <!-- Indicador de Status & Última Atualização -->
    <div class="d-flex align-items-center gap-2 ms-auto small">
        <span class="text-secondary" style="font-size: 0.72rem;">Atualização TSE:</span>
        <span class="font-mono fw-bold" style="color: var(--text-title);" id="lblDataTse">@(Model.DataHoraTse ?? "Aguardando totalização")</span>
    </div>
</div>

<!-- ========================================================================= -->
<!-- DASHBOARD PROFISSIONAL: 3 COLUNAS (DUELO ESQUERDA | MAPA CENTRO | FEED DIR) -->
<!-- ========================================================================= -->
<div class="row g-2 mb-0 dashboard-layout-row">
    <!-- ========================================== -->
    <!-- COLUNA ESQUERDA: CARD DUELO & EVOLUÇÃO     -->
    <!-- ========================================== -->
    <div class="col-12 col-xl-3 col-lg-4 dashboard-col-left">
        <!-- Card Principal da Disputa Presidencial -->
        <div class="duel-side-card p-3 mb-2">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-secondary small fw-semibold" style="font-size: 0.72rem;" id="lblDuelLocalidadeSubtitulo">
                    Presidente • @(!string.IsNullOrEmpty(Model.NomeMunicipio) ? $"{Model.NomeMunicipio} ({Model.Uf.ToUpperInvariant()})" : (Model.Uf == "br" ? "Brasil" : Model.Uf.ToUpperInvariant()))
                </span>
                <span class="badge bg-secondary-subtle text-secondary small py-0 px-2 rounded-pill font-mono" style="font-size: 0.68rem;" id="badgeStatusApuracao">
                    @(Model.Finalizado ? "• 2º turno · Definido" : (Model.PercentualTotalizado > 0 ? "• 2º turno · Ao vivo" : "• 2º turno · Aguardando totalização"))
                </span>
            </div>

            <!-- Título em Serif com Nomes dos Candidatos Coloridos -->
            <h2 class="h5 font-serif-headline mb-2" id="lblHeadlineDuelo">
                @if (Model.Ano == "2026")
                {
                    <span class="cand-headline-name-c2">@(cand2?.NomeUrna ?? "Candidato")</span><span class="cand-headline-connector"> e </span><span class="cand-headline-name-c1">@(cand1?.NomeUrna ?? "Candidato")</span><span class="cand-headline-connector"> foram ao 2º turno</span>
                }
                else if (Model.Finalizado && cand1 != null)
                {
                    <span class="cand-headline-name-c1">@cand1.NomeUrna</span><span class="cand-headline-connector"> é eleito Presidente da República</span>
                }
                else if (Model.PercentualTotalizado > 0 && cand1 != null)
                {
                    <span class="cand-headline-name-c1">@cand1.NomeUrna</span><span class="cand-headline-connector"> lidera a apuração para Presidente</span>
                }
                else if (cand1 != null && cand2 != null)
                {
                    <span class="cand-headline-name-c2">@cand2.NomeUrna</span><span class="cand-headline-connector"> e </span><span class="cand-headline-name-c1">@cand1.NomeUrna</span><span class="cand-headline-connector"> disputam a Presidência</span>
                }
                else
                {
                    <span class="cand-headline-connector">Apuração Presidencial 2º Turno</span>
                }
            </h2>

            <!-- Cards dos Dois Candidatos Lado a Lado -->
            <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
                <!-- Candidato 1 -->
                @if (cand1 != null)
                {
                    <div class="d-flex align-items-center gap-2 flex-grow-1">
                        <div class="cand-square-avatar" style="background: @cor1;">
                            @if (!string.IsNullOrWhiteSpace(cand1.FotoUrl))
                            {
                                <img src="@cand1.FotoUrl" alt="@cand1.NomeUrna" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                                <div style="display: none;">@(cand1.NomeUrna.Substring(0, Math.Min(2, cand1.NomeUrna.Length)))</div>
                            }
                            else if (FotoExiste(cand1.Numero))
                            {
                                <img src="/img/candidatos/@(cand1.Numero).jpg" alt="@cand1.NomeUrna" style="width: 100%; height: 100%; object-fit: cover;" />
                            }
                            else
                            {
                                <div>@(cand1.NomeUrna.Substring(0, Math.Min(2, cand1.NomeUrna.Length)))</div>
                            }
                        </div>
                        <div>
                            <div class="cand-title-name fw-bold small lh-1 mb-1">@cand1.NomeUrna</div>
                            <div class="small font-mono fw-bold" style="font-size: 0.72rem; color: @cor1;">@cand1.Partido @cand1.Numero</div>
                        </div>
                    </div>
                }

                <!-- Candidato 2 -->
                @if (cand2 != null)
                {
                    <div class="d-flex align-items-center justify-content-end gap-2 flex-grow-1 text-end">
                        <div>
                            <div class="cand-title-name fw-bold small lh-1 mb-1">@cand2.NomeUrna</div>
                            <div class="small font-mono fw-bold" style="font-size: 0.72rem; color: @cor2;">@cand2.Partido @cand2.Numero</div>
                        </div>
                        <div class="cand-square-avatar" style="background: @cor2;">
                            @if (!string.IsNullOrWhiteSpace(cand2.FotoUrl))
                            {
                                <img src="@cand2.FotoUrl" alt="@cand2.NomeUrna" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                                <div style="display: none;">@(cand2.NomeUrna.Substring(0, Math.Min(2, cand2.NomeUrna.Length)))</div>
                            }
                            else if (FotoExiste(cand2.Numero))
                            {
                                <img src="/img/candidatos/@(cand2.Numero).jpg" alt="@cand2.NomeUrna" style="width: 100%; height: 100%; object-fit: cover;" />
                            }
                            else
                            {
                                <div>@(cand2.NomeUrna.Substring(0, Math.Min(2, cand2.NomeUrna.Length)))</div>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- Percentuais Grandes -->
            <div class="d-flex align-items-baseline justify-content-between mb-2">
                <div class="text-start">
                    <div class="display-6 fw-bold font-display cand-percent-display" id="cand1Perc">
                        @(cand1?.Percentual.ToString("F2") ?? "0,00")<span class="fs-6 text-secondary">%</span>
                    </div>
                    <div class="small font-mono text-secondary" style="font-size: 0.75rem;" id="cand1Votos">
                        @(cand1?.Votos.ToString("N0") ?? "0") votos
                    </div>
                </div>

                <div class="text-end">
                    <div class="display-6 fw-bold font-display cand-percent-display" id="cand2Perc">
                        @(cand2?.Percentual.ToString("F2") ?? "0,00")<span class="fs-6 text-secondary">%</span>
                    </div>
                    <div class="small font-mono text-secondary" style="font-size: 0.75rem;" id="cand2Votos">
                        @(cand2?.Votos.ToString("N0") ?? "0") votos
                    </div>
                </div>
            </div>

            <!-- Barra Segmentada com Marcador de 50% -->
            <div class="duel-split-bar mb-2">
                <div class="threshold-50-marker"></div>
                @if (Model.PercentualTotalizado > 0 && (cand1?.Percentual > 0 || cand2?.Percentual > 0))
                {
                    <div id="barCand1" style="width: @(cand1?.Percentual.ToString("F2", System.Globalization.CultureInfo.InvariantCulture) ?? "50")%; background-color: @cor1; border-radius: 9999px 0 0 9999px;"></div>
                    <div id="barCand2" style="width: @(cand2?.Percentual.ToString("F2", System.Globalization.CultureInfo.InvariantCulture) ?? "50")%; background-color: @cor2; border-radius: 0 9999px 9999px 0; margin-left: auto;"></div>
                }
                else
                {
                    <div id="barCand1" style="width: 50%; background-color: @cor1; opacity: 0.65; border-radius: 9999px 0 0 9999px;"></div>
                    <div id="barCand2" style="width: 50%; background-color: @cor2; opacity: 0.65; border-radius: 0 9999px 9999px 0; margin-left: auto;"></div>
                }
            </div>

            <!-- Diferença e Meta -->
            <div class="d-flex align-items-center justify-content-between text-secondary small py-1 border-top border-themed mt-2" style="font-size: 0.74rem;">
                @if (Model.PercentualTotalizado > 0)
                {
                    <span>Diferença: <strong class="font-mono" style="color: var(--text-title);" id="lblDiffPontos">@Math.Abs((cand1?.Percentual ?? 0) - (cand2?.Percentual ?? 0)).ToString("F2") pts</strong> (@diffVotos.ToString("N0") votos)</span>
                }
                else
                {
                    <span>Diferença: <strong class="font-mono text-warning" id="lblDiffPontos">Aguardando apuração</strong></span>
                }
                <span>2º turno: <strong class="text-warning">25/10 • 17h</strong></span>
            </div>

            <!-- Resumo dos Votos Válidos, Comparecimento e Brancos/Nulos -->
            <div class="row g-2 pt-1 border-top border-themed text-center" style="font-size: 0.74rem;">
                <div class="col-4">
                    <div class="text-secondary" style="font-size: 0.68rem;">Votos válidos</div>
                    <div class="fw-bold font-mono" style="color: var(--text-title);" id="lblVotosValidos">@Model.VotosValidos.ToString("N0")</div>
                </div>
                <div class="col-4">
                    <div class="text-secondary" style="font-size: 0.68rem;">Comparecimento</div>
                    <div class="fw-bold font-mono" style="color: var(--text-title);" id="lblPercComparecimento">@Model.PercentualComparecimento.ToString("F1")%</div>
                </div>
                <div class="col-4">
                    <div class="text-secondary" style="font-size: 0.68rem;">Brancos e nulos</div>
                    <div class="fw-bold font-mono" style="color: var(--text-title);" id="lblPercBrancosNulos">@((Model.PercentualVotosBrancos + Model.PercentualVotosNulos).ToString("F1"))%</div>
                </div>
            </div>

            <!-- Contagem Regressiva do 2º Turno integrada -->
            <div class="d-flex align-items-center justify-content-between pt-1 mt-1 border-top border-themed small" style="font-size: 0.72rem;">
                <span class="text-secondary"><i class="bi bi-alarm text-info me-1"></i> Abertura da apuração (17h):</span>
                <span class="font-mono fw-bold" style="color: var(--text-title);" id="timerDigitsContainer">
                    <span id="cdDias">00</span><small class="text-secondary">d</small>
                    <span id="cdHoras">00</span><small class="text-secondary">h</small>
                    <span id="cdMinutos">00</span><small class="text-secondary">m</small>
                    <span id="cdSegundos" class="text-warning">00</span><small class="text-secondary">s</small>
                </span>
            </div>
        </div>

        <!-- Card "Ao longo da apuração" (Gráfico de Linha Interativo com proporção estendida até a base) -->
        <div class="sidebar-card p-3 card-ao-longo-apuracao">
            <div class="d-flex align-items-center justify-content-between mb-1">
                <span class="small fw-bold" style="color: var(--text-title);">Ao longo da apuração</span>
                <div class="d-flex align-items-center gap-2 small" style="font-size: 0.7rem;">
                    <span style="color: @cor1;">■ @(cand1?.NomeUrna ?? "C1")</span>
                    <span style="color: @cor2;">■ @(cand2?.NomeUrna ?? "C2")</span>
                </div>
            </div>

            <!-- Gráfico Vetorial em SVG (Escala completa para preencher o card) -->
            <div class="chart-box flex-grow-1 d-flex flex-column justify-content-between p-2" style="min-height: 0;">
                <svg viewBox="0 0 300 160" style="width: 100%; height: 100%; max-height: 100%; flex-grow: 1; overflow: visible;">
                    <!-- Linhas horizontais de grade (38% a 54%) -->
                    <line x1="28" y1="12" x2="295" y2="12" stroke="var(--chart-grid)" stroke-dasharray="2,2" />
                    <text x="5" y="14" fill="var(--chart-text)" font-size="7.5" font-family="monospace">54%</text>

                    <line x1="28" y1="30" x2="295" y2="30" stroke="var(--chart-grid)" stroke-dasharray="2,2" />
                    <text x="5" y="32" fill="var(--chart-text)" font-size="7.5" font-family="monospace">52%</text>

                    <line x1="28" y1="48" x2="295" y2="48" stroke="var(--chart-grid)" stroke-dasharray="2,2" />
                    <text x="5" y="50" fill="var(--chart-text)" font-size="7.5" font-family="monospace">50%</text>

                    <line x1="28" y1="66" x2="295" y2="66" stroke="var(--chart-grid)" stroke-dasharray="2,2" />
                    <text x="5" y="68" fill="var(--chart-text)" font-size="7.5" font-family="monospace">48%</text>

                    <line x1="28" y1="84" x2="295" y2="84" stroke="var(--chart-grid)" stroke-dasharray="2,2" />
                    <text x="5" y="86" fill="var(--chart-text)" font-size="7.5" font-family="monospace">46%</text>

                    <line x1="28" y1="102" x2="295" y2="102" stroke="var(--chart-grid)" stroke-dasharray="2,2" />
                    <text x="5" y="104" fill="var(--chart-text)" font-size="7.5" font-family="monospace">44%</text>

                    <line x1="28" y1="120" x2="295" y2="120" stroke="var(--chart-grid)" stroke-dasharray="2,2" />
                    <text x="5" y="122" fill="var(--chart-text)" font-size="7.5" font-family="monospace">42%</text>

                    <line x1="28" y1="138" x2="295" y2="138" stroke="var(--chart-grid)" stroke-dasharray="2,2" />
                    <text x="5" y="140" fill="var(--chart-text)" font-size="7.5" font-family="monospace">38%</text>

                    <!-- Curva Cand 2 (Azul/PL) -->
                    <path d="M 30,65 Q 75,38 140,50 T 290,75" fill="none" stroke="@cor2" stroke-width="2.2" />
                    <circle cx="290" cy="75" r="3" fill="@cor2" />

                    <!-- Curva Cand 1 (Vermelho/PT) -->
                    <path d="M 30,120 Q 75,130 140,125 T 290,88" fill="none" stroke="@cor1" stroke-width="2.2" />
                    <circle cx="290" cy="88" r="3" fill="@cor1" />

                    <!-- Eixo X (0% a 100%) -->
                    <text x="30" y="153" fill="var(--chart-text)" font-size="7.5">0% das seções</text>
                    <text x="145" y="153" fill="var(--chart-text)" font-size="7.5" text-anchor="middle">50%</text>
                    <text x="290" y="153" fill="var(--chart-text)" font-size="7.5" text-anchor="end">100%</text>
                </svg>
            </div>
        </div>
    </div>

    <!-- ========================================== -->
    <!-- COLUNA CENTRAL: MAPA & FILTROS & SCRUBBER  -->
    <!-- ========================================== -->
    <div class="col-12 col-xl-6 col-lg-5 dashboard-col-center">
        @await Html.PartialAsync("_MapaBrasil", Model)
    </div>

    <!-- ========================================== -->
    <!-- COLUNA DIREITA: POR REGIÃO & FEED AO VIVO  -->
    <!-- ========================================== -->
    <div class="col-12 col-xl-3 col-lg-3 dashboard-col-right">
        <!-- Card 1: Por Região (Quem lidera para presidente) -->
        <div class="sidebar-card p-3 mb-2 sidebar-card-regions">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="small fw-bold" style="color: var(--text-title);">Por região</span>
                <span class="text-secondary" style="font-size: 0.7rem;">Quem lidera para presidente</span>
            </div>

            <div class="d-flex flex-column">
                <!-- Norte -->
                <div class="region-row-v2">
                    <div class="region-info">
                        <span class="region-title">Norte</span>
                        <span class="region-sub">100%</span>
                    </div>
                    <div class="region-stats">
