<!-- Candidatos Adicionais (Caso seja histórico com mais de 2 candidatos) -->
@if (Model.Candidatos.Count > 2)
{
    <div class="glass-card p-4 mb-4">
        <h3 class="h6 fw-bold mb-3 text-white">
            <i class="bi bi-people-fill text-primary me-2"></i>Outros Candidatos com Votos Registrados
        </h3>
        <div class="row g-3" id="outrosCandidatosContainer">
            @for (int i = 2; i < Model.Candidatos.Count; i++)
            {
                var c = Model.Candidatos[i];
                <div class="col-md-6 col-lg-4">
                    <div class="cand-card">
                        <div class="cand-stripe" style="background-color: @(c.CorPartido ?? "#64748b");"></div>
                        <div class="d-flex align-items-center justify-content-between gap-2">
                            <div>
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <span class="badge text-white px-2 py-1 small font-mono" style="background-color: @(c.CorPartido ?? "#64748b");">@c.Numero</span>
                                    <h4 class="h6 mb-0 fw-bold text-white">@c.NomeUrna</h4>
                                </div>
                                <div class="small text-secondary">@c.Partido</div>
                            </div>
                            <div class="text-end">
                                <div class="fw-bold font-mono text-white">@c.Percentual.ToString("F2")%</div>
                                <div class="small text-secondary font-mono" style="font-size: 0.72rem;">@c.Votos.ToString("N0") votos</div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

@section Scripts {
    <script>
        const anoAtual = "@Model.Ano";
        const cargoAtual = "@Model.CargoCodigo";
        const ufAtual = "@Model.Uf";
        const municipioAtual = "@(Model.CodigoMunicipio ?? "")";

        let countdown = 30;
        const btnRefresh = document.getElementById("btnRefresh");
        const iconRefresh = document.getElementById("iconRefresh");
        const isAoVivo = @(Model.AoVivo ? "true" : "false");
        const isFinalizado = @(Model.Finalizado || Model.PercentualTotalizado >= 100 ? "true" : "false");

        // Auto-refresh a cada 30 segundos se for eleição ao vivo em andamento
        if (isAoVivo && !isFinalizado) {
            setInterval(() => {
                countdown--;
                if (countdown <= 0) {
                    countdown = 30;
                    atualizarDados();
                }
            }, 1000);
        }

        if (btnRefresh) {
            btnRefresh.addEventListener("click", () => {
                countdown = 30;
                atualizarDados();
            });
        }

        async function atualizarDados() {
            try {
                if (iconRefresh) {
                    iconRefresh.classList.add("fa-spin", "spinner-border", "spinner-border-sm");
                }
                const res = await fetch(`/Home/DadosApuracao?cargo=${cargoAtual}&uf=${ufAtual}&municipio=${municipioAtual}&ano=${anoAtual}`);
                if (!res.ok) throw new Error("Erro na requisição dos dados");

                const data = await res.json();

                // 1. Atualizar Header de Urnas
                const lblPerc = document.getElementById("lblSecoesPercHeader");
                if (lblPerc) lblPerc.innerText = `${data.percentualTotalizado.toFixed(2)}%`;

                const lblCount = document.getElementById("lblSecoesCountHeader");
                if (lblCount) {
                    lblCount.innerText = `${data.secoesTotalizadas.toLocaleString('pt-BR')} de ${data.totalSecoes.toLocaleString('pt-BR')} seções`;
                }

                const lblDetalhe = document.getElementById("lblSecoesDetalhe");
                if (lblDetalhe) lblDetalhe.innerText = `${data.percentualTotalizado.toFixed(2)}%`;

                const barGeral = document.getElementById("barSecoesGeral");
                if (barGeral) barGeral.style.width = data.percentualTotalizado.toFixed(2) + "%";

                // 2. Status Badge
                const badgeStatus = document.getElementById("badgeStatusApuracao");
                if (badgeStatus) {
                    if (data.finalizado) {
                        badgeStatus.className = "badge bg-success-subtle text-success border border-success-subtle px-2 py-1 rounded-pill";
                        badgeStatus.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i> Eleição Definida';
                    } else {
                        badgeStatus.className = "badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1 rounded-pill";
                        badgeStatus.innerHTML = '<i class="bi bi-hourglass-split me-1"></i> Apuração em Tempo Real';
                    }
                }

                // 3. Métricas
                const elVotosVal = document.getElementById("lblVotosValidos");
                if (elVotosVal) elVotosVal.innerText = data.votosValidos.toLocaleString('pt-BR');
                const elPercVal = document.getElementById("lblPercVotosValidos");
                if (elPercVal) elPercVal.innerText = `${data.percentualVotosValidos.toFixed(2)}% dos votos apurados`;

                const elComp = document.getElementById("lblComparecimento");
                if (elComp) elComp.innerText = data.comparecimento.toLocaleString('pt-BR');
                const elPercComp = document.getElementById("lblPercComparecimento");
                if (elPercComp) elPercComp.innerText = `${data.percentualComparecimento.toFixed(2)}% dos eleitores aptos`;

                const elAbst = document.getElementById("lblAbstencao");
                if (elAbst) elAbst.innerText = data.abstencao.toLocaleString('pt-BR');
                const elPercAbst = document.getElementById("lblPercAbstencao");
                if (elPercAbst) elPercAbst.innerText = `${data.percentualAbstencao.toFixed(2)}% não compareceram`;

                const elBN = document.getElementById("lblBrancosNulos");
                if (elBN) elBN.innerText = (data.votosBrancos + data.votosNulos).toLocaleString('pt-BR');
                const elPercBN = document.getElementById("lblPercBrancosNulos");
                if (elPercBN) {
                    elPercBN.innerText = `B: ${data.votosBrancos.toLocaleString('pt-BR')} (${data.percentualVotosBrancos.toFixed(2)}%) • N: ${data.votosNulos.toLocaleString('pt-BR')} (${data.percentualVotosNulos.toFixed(2)}%)`;
                }

                // 4. Timestamps
                if (data.dataHoraTse) {
                    const elTse = document.getElementById("lblDataTse");
                    if (elTse) elTse.innerText = data.dataHoraTse;
                }
                const elLocal = document.getElementById("lblDataLocal");
                if (elLocal) elLocal.innerText = new Date().toLocaleTimeString('pt-BR');

                // 5. Atualizar o Duelo Presidencial
                if (data.candidatos && data.candidatos.length > 0) {
                    const c1 = data.candidatos[0];
                    const c2 = data.candidatos.length > 1 ? data.candidatos[1] : null;

                    // Candidato 1
                    if (c1) {
                        const elNome1 = document.getElementById("cand1Nome");
                        if (elNome1) elNome1.innerText = c1.nomeUrna;
                        const elPerc1 = document.getElementById("cand1Perc");
                        if (elPerc1) elPerc1.innerText = `${c1.percentual.toFixed(2)}%`;
                        const elVotos1 = document.getElementById("cand1Votos");
                        if (elVotos1) elVotos1.innerText = `${c1.votos.toLocaleString('pt-BR')} votos`;

                        const bar1 = document.getElementById("barCand1");
                        if (bar1) bar1.style.width = c1.percentual.toFixed(2) + "%";
                    }

                    // Candidato 2
                    if (c2) {
                        const elNome2 = document.getElementById("cand2Nome");
                        if (elNome2) elNome2.innerText = c2.nomeUrna;
                        const elPerc2 = document.getElementById("cand2Perc");
                        if (elPerc2) elPerc2.innerText = `${c2.percentual.toFixed(2)}%`;
                        const elVotos2 = document.getElementById("cand2Votos");
                        if (elVotos2) elVotos2.innerText = `${c2.votos.toLocaleString('pt-BR')} votos`;

                        const bar2 = document.getElementById("barCand2");
                        if (bar2) bar2.style.width = c2.percentual.toFixed(2) + "%";
                    }

                    // Vantagem
                    const boxVantagem = document.getElementById("boxVantagem");
                    if (boxVantagem && c1 && c2) {
                        const diff = Math.abs(c1.votos - c2.votos);
                        const cLider = c1.votos >= c2.votos ? c1 : c2;
                        const cor = cLider.corPartido || "#2563eb";
                        boxVantagem.innerHTML = `
                            <span style="width: 10px; height: 10px; border-radius: 50%; background-color: ${cor}; display: inline-block;"></span>
                            <span>
                                <strong style="color: ${cor};">${escapeHtml(cLider.nomeUrna)}</strong> lidera por 
                                <strong class="font-mono text-white">+ ${diff.toLocaleString('pt-BR')}</strong> votos
                            </span>
                        `;
                    }
                }

                // 6. Recarregar Mapa do Brasil
                if (cargoAtual === "1") {
                    carregarMapaBrasil();
                }

            } catch (err) {
                console.error("Falha ao atualizar dados em tempo real:", err);
            } finally {
                if (iconRefresh) {
                    iconRefresh.classList.remove("fa-spin", "spinner-border", "spinner-border-sm");
                }
            }
        }

        function escapeHtml(text) {
            if (!text) return '';
            return String(text)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        // Funções do Mapa
        let dadosMapaCache = null;

        function alternarVisaoMapa(visao) {
            const boxBr = document.getElementById("visaoMapaBrasil");
            const boxSp = document.getElementById("visaoMapaSp");
            const btnBr = document.getElementById("btnToggleMapaBrasil");
            const btnSp = document.getElementById("btnToggleMapaSp");
            const lblTitulo = document.getElementById("lblMapaTitulo");

            if (visao === 'brasil') {
                if (boxBr) boxBr.style.display = "block";
                if (boxSp) boxSp.style.display = "none";
                if (btnBr) btnBr.classList.add("active");
                if (btnSp) btnSp.classList.remove("active");
                if (lblTitulo) lblTitulo.innerText = "Brasil (27 UFs)";
            } else {
                if (boxBr) boxBr.style.display = "none";
                if (boxSp) boxSp.style.display = "block";
                if (btnBr) btnBr.classList.remove("active");
                if (btnSp) btnSp.classList.add("active");
                if (lblTitulo) lblTitulo.innerText = "Estado de SP";
            }
        }

        async function carregarMapaBrasil() {
            try {
                const res = await fetch(`/Home/DadosMapaBrasil?ano=${anoAtual}`);
                if (!res.ok) return;

                const data = await res.json();
                dadosMapaCache = data;
                if (!data || !data.estados) return;

                // 1. Exterior ZZ
                const ufZz = data.estados["ZZ"] || data.estados["zz"];
                if (ufZz) {
                    const lblPercZz = document.getElementById("lblPercZz");
                    const lblLiderZz = document.getElementById("lblLiderZz");
                    const lblVotosZz = document.getElementById("lblVotosLiderZz");
                    const cardZz = document.getElementById("cardExteriorZz");

                    if (lblPercZz) lblPercZz.innerText = `${(ufZz.percentualTotalizado || 0).toFixed(1)}% apurado`;

                    if (ufZz.lider) {
                        const cor = ufZz.lider.corPartido || "#3b82f6";
                        if (lblLiderZz) {
                            lblLiderZz.innerHTML = `Líder: <strong style="color: ${cor};">${escapeHtml(ufZz.lider.nomeUrna)}</strong> (${escapeHtml(ufZz.lider.partido)}) • <strong>${ufZz.lider.percentual.toFixed(2)}%</strong>`;
                        }
                        if (lblVotosZz) {
                            lblVotosZz.innerText = `${(ufZz.lider.votos || 0).toLocaleString('pt-BR')} votos`;
                            lblVotosZz.style.backgroundColor = cor;
                        }
                        if (cardZz) cardZz.style.borderColor = cor;
                    }
                }

                // 2. Placar de Estados
                const placarContainer = document.getElementById("placarEstadosContainer");
                if (placarContainer && data.placar && data.placar.length > 0) {
                    let htmlPlacar = '';
                    for (const p of data.placar) {
                        const extBadge = p.lideraExterior ? ' <span class="badge bg-info-subtle text-info border border-info ms-1" style="font-size:0.68rem;">+ Exterior</span>' : '';
                        htmlPlacar += `
                            <div class="placar-cand-pill">
                                <span style="width: 9px; height: 9px; border-radius: 50%; background-color: ${p.corPartido}; display: inline-block;"></span>
                                <span class="fw-bold small" style="font-size: 0.78rem;">${escapeHtml(p.nomeUrna)}</span>
                                <span class="small text-secondary" style="font-size: 0.72rem;">(${escapeHtml(p.partido)})</span>
                                <span class="badge font-mono ms-1 text-white" style="background-color: ${p.corPartido}; color: #ffffff !important; font-size: 0.74rem; font-weight: 600;">${p.totalEstadosLiderando} ${p.totalEstadosLiderando === 1 ? 'estado' : 'estados'}</span>
                                ${extBadge}
                            </div>
                        `;
                    }
                    placarContainer.innerHTML = htmlPlacar;
                }

                // 3. Pintar os Estados no SVG
                aplicarCoresMapaBrasil(data);

                // 4. Contador de estados
                const lblTotalizados = document.getElementById("lblEstadosApuradosCount");
                if (lblTotalizados) {
                    lblTotalizados.innerText = `Totalizados: ${data.estadosTotalizados || 0} / 27`;
                }

            } catch (err) {
                console.warn("Falha ao carregar dados do Mapa do Brasil:", err);
            }
        }

        function aplicarCoresMapaBrasil(data) {
            if (!data || !data.estados) return;
            const isLight = document.documentElement.getAttribute('data-theme') === 'light';
            const paths = document.querySelectorAll("#svgMapaBrasil .estado-path");
            
            paths.forEach(path => {
                const uf = path.getAttribute("data-uf");
                if (!uf) return;

                const estadoData = data.estados[uf] || data.estados[uf.toUpperCase()];
                if (estadoData && estadoData.lider && estadoData.percentualTotalizado > 0) {
                    path.style.fill = estadoData.lider.corPartido || "#3b82f6";
                    path.style.stroke = isLight ? "#ffffff" : "#0f172a";
                    path.style.strokeWidth = "1.5";
                } else {
                    path.style.fill = isLight ? "#e2e8f0" : "#1e293b";
                    path.style.stroke = isLight ? "#cbd5e1" : "rgba(255,255,255,0.14)";
                    path.style.strokeWidth = "1.2";
                }
            });
        }

        function configurarInteracaoMapaBrasil() {
            const svg = document.getElementById("svgMapaBrasil");
            const tooltip = document.getElementById("mapBrasilTooltip");
            if (!svg || !tooltip) return;

            const paths = svg.querySelectorAll(".estado-path");
            paths.forEach(path => {
                const uf = path.getAttribute("data-uf");

                path.addEventListener("mouseenter", (e) => {
                    if (!dadosMapaCache || !dadosMapaCache.estados) return;
                    const estadoData = dadosMapaCache.estados[uf] || dadosMapaCache.estados[uf.toUpperCase()];
                    if (!estadoData) return;

                    document.getElementById("ttUfNome").innerText = estadoData.nome || uf;
                    document.getElementById("ttUfPerc").innerText = `${(estadoData.percentualTotalizado || 0).toFixed(1)}% apurado`;

                    const ttLiderBox = document.getElementById("ttLiderBox");
                    const ttViceBox = document.getElementById("ttViceBox");

                    if (estadoData.lider) {
                        ttLiderBox.style.display = "flex";
                        document.getElementById("ttLiderCor").style.backgroundColor = estadoData.lider.corPartido;
                        document.getElementById("ttLiderNome").innerText = estadoData.lider.nomeUrna;
                        document.getElementById("ttLiderPart").innerText = `(${estadoData.lider.partido})`;
                        document.getElementById("ttLiderPerc").innerText = `${estadoData.lider.percentual.toFixed(2)}%`;
                    } else {
                        ttLiderBox.style.display = "none";
                    }

                    if (estadoData.viceLider) {
                        ttViceBox.style.display = "flex";
                        document.getElementById("ttViceCor").style.backgroundColor = estadoData.viceLider.corPartido;
                        document.getElementById("ttViceNome").innerText = estadoData.viceLider.nomeUrna;
                        document.getElementById("ttVicePart").innerText = `(${estadoData.viceLider.partido})`;
                        document.getElementById("ttVicePerc").innerText = `${estadoData.viceLider.percentual.toFixed(2)}%`;
                    } else {
                        ttViceBox.style.display = "none";
                    }

                    tooltip.style.display = "block";
                    tooltip.style.opacity = "1";
                });

                path.addEventListener("mousemove", (e) => {
                    const wrapper = svg.closest(".svg-brasil-wrapper");
                    if (!wrapper) return;
                    const wrapRect = wrapper.getBoundingClientRect();

                    const x = e.clientX - wrapRect.left;
                    const y = e.clientY - wrapRect.top;

                    tooltip.style.left = x + "px";
                    tooltip.style.top = y + "px";
                });

                path.addEventListener("mouseleave", () => {
                    tooltip.style.opacity = "0";
                    setTimeout(() => {
                        if (tooltip.style.opacity === "0") tooltip.style.display = "none";
                    }, 150);
                });

                path.addEventListener("click", () => {
                    window.location.href = `?ano=${anoAtual}&cargo=1&uf=${uf.toLowerCase()}`;
                });
            });
        }

        // Contagem Regressiva para o 2º Turno das Eleições 2026 (25/10)
        function iniciarContagemRegressiva2T() {
            // Horário oficial de Brasília (UTC-3)
            const targetInicio = new Date("2026-10-25T08:00:00-03:00").getTime();
            const targetFim = new Date("2026-10-25T17:00:00-03:00").getTime();

            const elDias = document.getElementById("cdDias");
            const elHoras = document.getElementById("cdHoras");
            const elMinutos = document.getElementById("cdMinutos");
            const elSegundos = document.getElementById("cdSegundos");
            const elTitulo = document.getElementById("tituloCountdown2T");
            const elBadge = document.getElementById("badgeCountdownState");
            const elIcon = document.getElementById("iconCountdownState");
            const containerDigits = document.getElementById("timerDigitsContainer");

            function atualizarContador() {
                const agora = new Date().getTime();
                const diffInicio = targetInicio - agora;
                const diffFim = targetFim - agora;

                if (diffInicio > 0) {
                    // Fase 1: Antes da abertura das urnas (antes das 08h de 25/10)
                    const dias = Math.floor(diffInicio / (1000 * 60 * 60 * 24));
                    const horas = Math.floor((diffInicio % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                    const minutos = Math.floor((diffInicio % (1000 * 60 * 60)) / (1000 * 60));
                    const segundos = Math.floor((diffInicio % (1000 * 60)) / 1000);

                    if (elDias) elDias.innerText = String(dias).padStart(2, '0');
                    if (elHoras) elHoras.innerText = String(horas).padStart(2, '0');
                    if (elMinutos) elMinutos.innerText = String(minutos).padStart(2, '0');
                    if (elSegundos) elSegundos.innerText = String(segundos).padStart(2, '0');

                    if (elTitulo) elTitulo.innerText = "Contagem Regressiva para a Abertura das Urnas";
                    if (elIcon) elIcon.className = "bi bi-alarm fs-4";
                } 
                else if (diffFim > 0) {
                    // Fase 2: Durante o período de votação (entre 08h e 17h de 25/10)
                    const horas = Math.floor(diffFim / (1000 * 60 * 60));
                    const minutos = Math.floor((diffFim % (1000 * 60 * 60)) / (1000 * 60));
                    const segundos = Math.floor((diffFim % (1000 * 60)) / 1000);

                    if (elDias) elDias.innerText = "00";
                    if (elHoras) elHoras.innerText = String(horas).padStart(2, '0');
                    if (elMinutos) elMinutos.innerText = String(minutos).padStart(2, '0');
                    if (elSegundos) elSegundos.innerText = String(segundos).padStart(2, '0');

                    if (elTitulo) elTitulo.innerHTML = `<span class="text-success"><i class="bi bi-broadcast me-1"></i>Votação em Andamento!</span> Urnas fecham em:`;
                    if (elBadge) {
                        elBadge.className = "badge bg-success text-white small px-2 py-1 rounded-pill fw-bold";
                        elBadge.innerHTML = `<span class="pulse-nav me-1"></span> VOTAÇÃO EM ANDAMENTO (08H ÀS 17H)`;
                    }
                    if (elIcon) elIcon.className = "bi bi-hourglass-split fs-4 text-warning";
                } 
                else {
                    // Fase 3: Votação encerrada (após as 17h de 25/10)
                    if (elTitulo) elTitulo.innerHTML = `<span class="text-warning"><i class="bi bi-shield-check me-1"></i>Urnas Encerradas às 17h!</span> Apuração Oficial em Andamento`;
                    if (elBadge) {
                        elBadge.className = "badge bg-warning text-dark small px-2 py-1 rounded-pill fw-bold";
                        elBadge.innerHTML = `<i class="bi bi-lightning-charge-fill me-1"></i> APURAÇÃO OFICIAL EM ANDAMENTO`;
                    }
                    if (elIcon) elIcon.className = "bi bi-check2-circle fs-4 text-success";

                    if (containerDigits) {
                        containerDigits.innerHTML = `
                            <div class="badge bg-primary-subtle text-primary border border-primary px-3 py-2 fs-6 rounded-pill">
                                <i class="bi bi-broadcast me-1"></i> Acompanhe os Votos ao Vivo Abaixo
                            </div>`;
                    }
                }
            }

            atualizarContador();
            setInterval(atualizarContador, 1000);
        }

        document.addEventListener("DOMContentLoaded", () => {
            configurarInteracaoMapaBrasil();
            iniciarContagemRegressiva2T();
            if (cargoAtual === "1") {
                carregarMapaBrasil();
            } else {
                alternarVisaoMapa('sp');
            }

            // Alternar tema e repintar mapa
            const observerTema = new MutationObserver(() => {
                if (dadosMapaCache) {
                    aplicarCoresMapaBrasil(dadosMapaCache);
                }
            });
            observerTema.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
        });
    </script>
}
