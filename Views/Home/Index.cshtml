        </div>

        <!-- Card 2: Últimas Atualizações (Feed com Esmaecimento Gradiente Inferior e sem Rollover) -->
        <div class="sidebar-card p-3 sidebar-card-feed">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="small fw-bold" style="color: var(--text-title); font-size: 0.9rem;">Últimas atualizações</span>
                <span class="badge bg-danger-subtle text-danger small py-0 px-1 font-mono" style="font-size: 0.65rem;">• Ao vivo</span>
            </div>

            <!-- Feed com esmaecido gradiente inferior para evitar o rollover/scrollbar -->
            <div class="news-feed-fade-container" id="newsFeedListContainer">
                @if (Model.Noticias != null && Model.Noticias.Count > 0)
                {
                    @foreach (var notic in Model.Noticias)
                    {
                        <div class="news-row-v2 @(notic.Destaque ? "news-row-destaque" : "")">
                            <span class="news-time">@notic.Hora</span>
                            @if (!string.IsNullOrEmpty(notic.AvatarUrl))
                            {
                                <img src="@notic.AvatarUrl" alt="Foto" class="news-avatar" onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='inline-flex';" />
                                <div class="news-icon-circle" style="display: none;">
                                    <i class="bi bi-person-fill"></i>
                                </div>
                            }
                            else
                            {
                                <div class="news-icon-circle">
                                    <i class="bi @(string.IsNullOrEmpty(notic.Icone) ? "bi-circle" : notic.Icone)"></i>
                                </div>
                            }
                            <div class="news-body">
                                @Html.Raw(notic.ConteudoHtml)
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="p-3 text-center text-secondary small">
                        <i class="bi bi-clock-history d-block mb-1 fs-5"></i>
                        Aguardando início da apuração das urnas às 17h.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script src="~/js/geolocalizacao.js" asp-append-version="true"></script>
    <script src="~/js/mapa-eleicoes.js" asp-append-version="true"></script>

    <script>
        let anoAtual = "@Model.Ano";
        let cargoAtual = "@Model.CargoCodigo";
        let ufAtual = "@Model.Uf";
        let municipioAtual = "@(Model.CodigoMunicipio ?? "")";
        window.anoAtual = anoAtual;
        window.cargoAtual = cargoAtual;
        window.ufAtual = ufAtual;
        window.municipioAtual = municipioAtual;

        // Navegação fluida para município sem recarregar a tela (SPA) e subindo suavemente
        window.navegarParaCidadeSemReload = async function(nomeMun, cod, uf) {
            // 1. Fechar modal de zonas se aberto
            const modalEl = document.getElementById("modalZonasEleitorais");
            if (modalEl) {
                const bsModal = bootstrap.Modal.getInstance(modalEl) || bootstrap.Modal.getOrCreateInstance(modalEl);
                if (bsModal) bsModal.hide();
            }

            // 2. Subir suavemente até o topo da tela
            window.scrollTo({ top: 0, behavior: 'smooth' });

            // 3. Atualizar URL no histórico sem refresh
            const ufLimpa = (uf || 'sp').toLowerCase();
            const ano = window.anoAtual || '2026';
            const novaUrl = cod ? `?ano=${ano}&cargo=1&uf=${ufLimpa}&municipio=${cod}` : `?ano=${ano}&cargo=1&uf=${ufLimpa}`;
            window.history.pushState({ path: novaUrl }, '', novaUrl);

            // 4. Atualizar o cabeçalho da disputa presidencial
            const elSub = document.getElementById("lblDuelLocalidadeSubtitulo");
            if (elSub) {
                elSub.innerText = cod ? `Presidente • ${nomeMun} (${ufLimpa.toUpperCase()})` : `Presidente • ${ufLimpa.toUpperCase()}`;
            }

            // 5. Atualizar trilha de chips de localidade
            if (window.GeoLocalizacaoService) {
                window.GeoLocalizacaoService.aplicarTrilhaLocalidade(ano, '1', ufLimpa, cod, nomeMun);
            }

            // 6. Atualizar variáveis de estado e buscar dados via AJAX
            ufAtual = ufLimpa;
            municipioAtual = cod || "";
            window.ufAtual = ufLimpa;
            window.municipioAtual = cod || "";

            await atualizarDados();
        };

        window.addEventListener('popstate', () => {
            const params = new URLSearchParams(window.location.search);
            const m = params.get('municipio') || '';
            const u = params.get('uf') || 'br';
            ufAtual = u;
            municipioAtual = m;
            window.ufAtual = u;
            window.municipioAtual = m;
            atualizarDados();
        });

        let countdown = 30;
        const btnRefresh = document.getElementById("btnRefresh");
        const iconRefresh = document.getElementById("iconRefresh");
        const isAoVivo = @(Model.AoVivo ? "true" : "false");
        const isFinalizado = @(Model.Finalizado || Model.PercentualTotalizado >= 100 ? "true" : "false");

        // Relógio Dinâmico na Barra Inferior
        function atualizarRelogioScrubber() {
            const elClock = document.getElementById("lblLiveClockScrubber");
            if (elClock) {
                elClock.innerText = new Date().toLocaleTimeString('pt-BR');
            }
        }
        setInterval(atualizarRelogioScrubber, 1000);

        if (isAoVivo && !isFinalizado) {
            setInterval(() => {
                countdown--;
                if (countdown <= 0) {
                    countdown = 30;
                    atualizarDados();
                }
            }, 1000);
        }

        if (btnRefresh) {
            btnRefresh.addEventListener("click", () => {
                countdown = 30;
                atualizarDados();
            });
        }

        async function atualizarDados() {
            try {
                if (iconRefresh) iconRefresh.classList.add("fa-spin", "spinner-border", "spinner-border-sm");
                const res = await fetch(`/Home/DadosApuracao?cargo=${cargoAtual}&uf=${ufAtual}&municipio=${municipioAtual}&ano=${anoAtual}`);
                if (!res.ok) throw new Error("Erro na requisição dos dados");
                const data = await res.json();

                if (data.candidatos && data.candidatos.length > 0) {
                    const c1 = data.candidatos[0];
                    const c2 = data.candidatos.length > 1 ? data.candidatos[1] : null;
                    const percTotal = data.percentualTotalizado || 0;

                    // Atualizar Badge de Status
                    const elBadge = document.getElementById("badgeStatusApuracao");
                    if (elBadge) {
                        elBadge.innerText = data.finalizado 
                            ? "• 2º turno · Definido" 
                            : (percTotal > 0 ? "• 2º turno · Ao vivo" : "• 2º turno · Aguardando totalização");
                    }

                    // Atualizar Headline Dinâmica
                    const elHeadline = document.getElementById("lblHeadlineDuelo");
                    if (elHeadline) {
                        if (anoAtual === "2026") {
                            elHeadline.innerHTML = `<span class="cand-headline-name-c2">${c2 ? c2.nomeUrna : ''}</span><span class="cand-headline-connector"> e </span><span class="cand-headline-name-c1">${c1 ? c1.nomeUrna : ''}</span><span class="cand-headline-connector"> foram ao 2º turno</span>`;
                        } else if (data.finalizado && c1) {
                            elHeadline.innerHTML = `<span class="cand-headline-name-c1">${c1.nomeUrna}</span><span class="cand-headline-connector"> é eleito Presidente da República</span>`;
                        } else if (percTotal > 0 && c1) {
                            elHeadline.innerHTML = `<span class="cand-headline-name-c1">${c1.nomeUrna}</span><span class="cand-headline-connector"> lidera a apuração para Presidente</span>`;
                        } else if (c1 && c2) {
                            elHeadline.innerHTML = `<span class="cand-headline-name-c2">${c2.nomeUrna}</span><span class="cand-headline-connector"> e </span><span class="cand-headline-name-c1">${c1.nomeUrna}</span><span class="cand-headline-connector"> disputam a Presidência</span>`;
                        }
                    }

                    if (c1) {
                        const elPerc1 = document.getElementById("cand1Perc");
                        if (elPerc1) elPerc1.innerHTML = `${c1.percentual.toFixed(2)}<span class="fs-6 text-secondary">%</span>`;
                        const elVotos1 = document.getElementById("cand1Votos");
                        if (elVotos1) elVotos1.innerText = `${c1.votos.toLocaleString('pt-BR')} votos`;
                        const bar1 = document.getElementById("barCand1");
                        if (bar1) bar1.style.width = (percTotal > 0 ? c1.percentual.toFixed(2) : "50") + "%";
                    }

                    if (c2) {
                        const elPerc2 = document.getElementById("cand2Perc");
                        if (elPerc2) elPerc2.innerHTML = `${c2.percentual.toFixed(2)}<span class="fs-6 text-secondary">%</span>`;
                        const elVotos2 = document.getElementById("cand2Votos");
                        if (elVotos2) elVotos2.innerText = `${c2.votos.toLocaleString('pt-BR')} votos`;
                        const bar2 = document.getElementById("barCand2");
                        if (bar2) bar2.style.width = (percTotal > 0 ? c2.percentual.toFixed(2) : "50") + "%";
                    }

                    if (c1 && c2) {
                        const diffPts = Math.abs(c1.percentual - c2.percentual);
                        const diffV = Math.abs(c1.votos - c2.votos);
                        const elDiff = document.getElementById("lblDiffPontos");
                        if (elDiff) {
                            elDiff.innerText = percTotal > 0 ? `${diffPts.toFixed(2)} pts` : "Aguardando apuração";
                        }
                    }
                }

                // Atualizar Votos Válidos, Comparecimento e Brancos/Nulos
                if (data.votosValidos !== undefined) {
                    const elVv = document.getElementById("lblVotosValidos");
                    if (elVv) elVv.innerText = data.votosValidos.toLocaleString('pt-BR');
                }
                if (data.percentualComparecimento !== undefined) {
                    const elComp = document.getElementById("lblPercComparecimento");
                    if (elComp) elComp.innerText = data.percentualComparecimento.toFixed(1) + "%";
                }
                if (data.percentualVotosBrancos !== undefined && data.percentualVotosNulos !== undefined) {
                    const elBn = document.getElementById("lblPercBrancosNulos");
                    if (elBn) elBn.innerText = (data.percentualVotosBrancos + data.percentualVotosNulos).toFixed(1) + "%";
                }

                // Atualizar Feed de Notícias em tempo real
                if (data.noticias && data.noticias.length > 0) {
                    const containerNoticias = document.getElementById("newsFeedListContainer");
                    if (containerNoticias) {
                        let htmlFeed = '';
                        data.noticias.forEach(n => {
                            const avatarHtml = n.avatarUrl 
                                ? `<img src="${n.avatarUrl}" alt="Foto" class="news-avatar" onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='inline-flex';" /><div class="news-icon-circle" style="display: none;"><i class="bi bi-person-fill"></i></div>`
                                : `<div class="news-icon-circle"><i class="bi ${n.icone || 'bi-circle'}"></i></div>`;
                            
                            htmlFeed += `
                                <div class="news-row-v2 ${n.destaque ? 'news-row-destaque' : ''}">
                                    <span class="news-time">${n.hora || ''}</span>
                                    ${avatarHtml}
                                    <div class="news-body">${n.conteudoHtml || ''}</div>
                                </div>
                            `;
                        });
                        containerNoticias.innerHTML = htmlFeed;
                    }
                }

                if (data.dataHoraTse) {
                    const elTse = document.getElementById("lblDataTse");
                    if (elTse) elTse.innerText = data.dataHoraTse;
                }

                if (cargoAtual === "1") {
                    carregarMapaBrasil();
                }
            } catch (e) {
                console.warn(e);
            } finally {
                if (iconRefresh) iconRefresh.classList.remove("fa-spin", "spinner-border", "spinner-border-sm");
            }
        }

        async function carregarMapaBrasil() {
            try {
                const res = await fetch(`/Home/DadosMapaBrasil?ano=${anoAtual}`);
                if (!res.ok) return;
                const data = await res.json();
                if (window.MapaEleicoesLeaflet && data) {
                    MapaEleicoesLeaflet.renderizarEstados(data);
                }
            } catch (err) {
                console.warn(err);
            }
        }

        // Contagem Regressiva para Início da Apuração (25/10 às 17h)
        function iniciarContagemRegressiva2T() {
            const target = new Date("2026-10-25T17:00:00-03:00").getTime();
            function tick() {
                const agora = new Date().getTime();
                const diff = target - agora;
                const elContainer = document.getElementById("timerDigitsContainer");
                if (diff > 0) {
                    const dias = Math.floor(diff / (1000 * 60 * 60 * 24));
                    const horas = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                    const minutos = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
                    const segundos = Math.floor((diff % (1000 * 60)) / 1000);

                    const elD = document.getElementById("cdDias");
                    const elH = document.getElementById("cdHoras");
                    const elM = document.getElementById("cdMinutos");
                    const elS = document.getElementById("cdSegundos");
                    if (elD) elD.innerText = String(dias).padStart(2, '0');
                    if (elH) elH.innerText = String(horas).padStart(2, '0');
                    if (elM) elM.innerText = String(minutos).padStart(2, '0');
                    if (elS) elS.innerText = String(segundos).padStart(2, '0');
                } else if (elContainer) {
                    elContainer.innerHTML = '<span class="text-danger fw-bold"><i class="bi bi-broadcast me-1"></i> Apuração em andamento</span>';
                }
            }
            tick();
            setInterval(tick, 1000);
        }

        // Monitoramento de Pessoas Online em Tempo Real (Presença)
        let sessionIdPresenca = sessionStorage.getItem("presenca_cid");
        if (!sessionIdPresenca) {
            sessionIdPresenca = "usr_" + Math.random().toString(36).substring(2, 11) + Date.now().toString(36);
            sessionStorage.setItem("presenca_cid", sessionIdPresenca);
        }

        async function atualizarPresenca() {
            try {
                const res = await fetch(`/api/apuracao/presenca?id=${encodeURIComponent(sessionIdPresenca)}`);
                if (!res.ok) return;
                const data = await res.json();
                if (data && data.online !== undefined) {
                    const elCount = document.getElementById("lblOnlineCount");
                    if (elCount) {
                        elCount.innerText = data.online === 1 ? "1 pessoa" : `${data.online} pessoas`;
                    }
                }
            } catch (err) {
                console.warn("Falha no heartbeat de presença:", err);
            }
        }

        // Histórico da Apuração no Tempo (Scrubber Timeline)
        let timelinePontos = [];
        let valoresOriginaisDuelo = null;

        async function carregarTimelineScrubber() {
            try {
                const res = await fetch('/api/apuracao/timeline');
                if (!res.ok) return;
                const data = await res.json();
                if (data && data.timeline) {
                    timelinePontos = data.timeline;
                }
            } catch (e) {
                console.warn("Timeline indisponível:", e);
            }
        }

        function configurarScrubberTimeline() {
            const rangeEl = document.getElementById("rangeScrubberApuracao");
            if (!rangeEl) return;

            // Salvar valores iniciais ao vivo
            valoresOriginaisDuelo = {
                cand1Perc: document.getElementById("cand1Perc") ? document.getElementById("cand1Perc").innerHTML : "",
                cand2Perc: document.getElementById("cand2Perc") ? document.getElementById("cand2Perc").innerHTML : "",
                barCand1: document.getElementById("barCand1") ? document.getElementById("barCand1").style.width : "50%",
                barCand2: document.getElementById("barCand2") ? document.getElementById("barCand2").style.width : "50%",
                clock: document.getElementById("lblLiveClockScrubber") ? document.getElementById("lblLiveClockScrubber").innerText : "19:04:32"
            };

            rangeEl.addEventListener("input", (e) => {
                const val = parseInt(e.target.value, 10);
                const elCurr = document.getElementById("lblScrubberCurrent");
                if (elCurr) elCurr.innerText = val + "%";

                if (timelinePontos.length > 0) {
                    // Encontrar ponto mais próximo
                    let ponto = timelinePontos[timelinePontos.length - 1];
                    for (let i = 0; i < timelinePontos.length; i++) {
                        if (val <= timelinePontos[i].pct) {
                            ponto = timelinePontos[i];
                            break;
                        }
                    }

                    const elClock = document.getElementById("lblLiveClockScrubber");
                    if (elClock && ponto.hora) {
                        elClock.innerText = ponto.hora;
                    }

                    if (val < 100) {
                        const elP1 = document.getElementById("cand1Perc");
                        if (elP1) elP1.innerHTML = `${ponto.cand1.toFixed(2)}<span class="fs-6 text-secondary">%</span>`;
                        const elP2 = document.getElementById("cand2Perc");
                        if (elP2) elP2.innerHTML = `${ponto.cand2.toFixed(2)}<span class="fs-6 text-secondary">%</span>`;
                        const b1 = document.getElementById("barCand1");
                        if (b1) b1.style.width = ponto.cand1.toFixed(2) + "%";
                        const b2 = document.getElementById("barCand2");
                        if (b2) b2.style.width = ponto.cand2.toFixed(2) + "%";
                        const diffEl = document.getElementById("lblDiffPontos");
                        if (diffEl) diffEl.innerText = `${ponto.diff.toFixed(2)} pts`;
                    } else if (valoresOriginaisDuelo) {
                        const elP1 = document.getElementById("cand1Perc");
                        if (elP1) elP1.innerHTML = valoresOriginaisDuelo.cand1Perc;
                        const elP2 = document.getElementById("cand2Perc");
                        if (elP2) elP2.innerHTML = valoresOriginaisDuelo.cand2Perc;
                        const b1 = document.getElementById("barCand1");
                        if (b1) b1.style.width = valoresOriginaisDuelo.barCand1;
                        const b2 = document.getElementById("barCand2");
                        if (b2) b2.style.width = valoresOriginaisDuelo.barCand2;
                    }
                }
            });
        }

        document.addEventListener("DOMContentLoaded", () => {
            iniciarContagemRegressiva2T();
            atualizarPresenca();
            setInterval(atualizarPresenca, 15000);
            carregarTimelineScrubber().then(() => {
                configurarScrubberTimeline();
            });

            if (window.MapaEleicoesLeaflet) {
                MapaEleicoesLeaflet.inicializar("mapaInterativoLeaflet");
                if (ufAtual === "sp") {
                    MapaEleicoesLeaflet.alternarVisao('sp');
                } else if (ufAtual === "zz") {
                    MapaEleicoesLeaflet.alternarVisao('exterior');
                } else {
                    MapaEleicoesLeaflet.alternarVisao('brasil');
                }
            }

            if (cargoAtual === "1") {
                carregarMapaBrasil();
            }

            if (window.GeoLocalizacaoService) {
                GeoLocalizacaoService.aplicarTrilhaLocalidade(anoAtual, cargoAtual, ufAtual, municipioAtual, '@(Model.NomeMunicipio ?? "")');
            }
        });
    </script>
}
