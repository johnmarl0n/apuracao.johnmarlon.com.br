                    <div class="d-flex justify-content-between mb-1">
                        <span>Área Territorial:</span>
                        <strong class="text-white">@info.AreaKm2</strong>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span>Zonas Eleitorais:</span>
                        <strong class="text-white text-end">@info.ZonasEleitorais</strong>
