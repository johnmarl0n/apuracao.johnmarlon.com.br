                            <span class="region-pct">47,6%</span>
                            <span class="region-diff">+0,4</span>
                        </div>
                        <div class="mini-duel-bar-wrap">
                            <div class="mini-duel-tick"></div>
                            <div class="mini-duel-fill" style="right: 50%; width: 46%; background: #ef4444;"></div>
