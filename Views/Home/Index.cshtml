                <!-- Nordeste -->
                <div class="region-row-v2">
                    <div class="region-info">
                        <span class="region-title">Nordeste</span>
                        <span class="region-sub">100%</span>
                    </div>
                    <div class="region-stats">
                        <div class="region-cand-pill">
                            <img src="/img/candidatos/lula.webp" alt="PT" class="region-avatar" onerror="this.src='/img/candidatos/13.jpg';" />
                            <span class="region-party region-party-pt">PT</span>
                            <span class="region-pct">63,8%</span>
                            <span class="region-diff">-3,0</span>
                        </div>
                        <div class="mini-duel-bar-wrap">
                            <div class="mini-duel-tick"></div>
                            <div class="mini-duel-fill" style="right: 50%; width: 48%; background: #ef4444;"></div>
                        </div>
                    </div>
                </div>

                <!-- Centro-Oeste -->
                <div class="region-row-v2">
                    <div class="region-info">
                        <span class="region-title">Centro-Oeste</span>
                        <span class="region-sub">100%</span>
                    </div>
                    <div class="region-stats">
                        <div class="region-cand-pill">
                            <img src="/img/candidatos/bolsonaro.webp" alt="PL" class="region-avatar" onerror="this.src='/img/candidatos/22.jpg';" />
                            <span class="region-party region-party-pl">PL</span>
                            <span class="region-pct">56,5%</span>
                            <span class="region-diff">+2,7</span>
                        </div>
                        <div class="mini-duel-bar-wrap">
                            <div class="mini-duel-tick"></div>
                            <div class="mini-duel-fill" style="left: 50%; width: 48%; background: #3b82f6;"></div>
                        </div>
                    </div>
                </div>

                <!-- Sudeste -->
                <div class="region-row-v2">
                    <div class="region-info">
                        <span class="region-title">Sudeste</span>
                        <span class="region-sub">100%</span>
                    </div>
                    <div class="region-stats">
                        <div class="region-cand-pill">
                            <img src="/img/candidatos/bolsonaro.webp" alt="PL" class="region-avatar" onerror="this.src='/img/candidatos/22.jpg';" />
                            <span class="region-party region-party-pl">PL</span>
                            <span class="region-pct">51,4%</span>
                            <span class="region-diff">+3,8</span>
                        </div>
                        <div class="mini-duel-bar-wrap">
                            <div class="mini-duel-tick"></div>
                            <div class="mini-duel-fill" style="left: 50%; width: 48%; background: #3b82f6;"></div>
                        </div>
                    </div>
                </div>

                <!-- Sul -->
                <div class="region-row-v2">
                    <div class="region-info">
                        <span class="region-title">Sul</span>
                        <span class="region-sub">100%</span>
                    </div>
                    <div class="region-stats">
                        <div class="region-cand-pill">
                            <img src="/img/candidatos/bolsonaro.webp" alt="PL" class="region-avatar" onerror="this.src='/img/candidatos/22.jpg';" />
                            <span class="region-party region-party-pl">PL</span>
                            <span class="region-pct">60,1%</span>
                            <span class="region-diff">+5,5</span>
                        </div>
                        <div class="mini-duel-bar-wrap">
                            <div class="mini-duel-tick"></div>
                            <div class="mini-duel-fill" style="left: 50%; width: 48%; background: #3b82f6;"></div>
                        </div>
                    </div>
                </div>

                <!-- Exterior (ZZ) -->
                <div class="region-row-v2">
                    <div class="region-info">
                        <span class="region-title d-flex align-items-center gap-1">
                            <i class="bi bi-globe2" style="font-size: 0.8rem; opacity: 0.85;"></i> Exterior
                        </span>
                        <span class="region-sub">100%</span>
                    </div>
                    <div class="region-stats">
                        <div class="region-cand-pill">
                            <img src="/img/candidatos/lula.webp" alt="PT" class="region-avatar" onerror="this.src='/img/candidatos/13.jpg';" />
