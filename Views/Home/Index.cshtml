@model apuracao.johnmarlon.com.br.Models.ApuracaoViewModel
@functions {
    bool FotoExiste(string? numero)
    {
        if (string.IsNullOrWhiteSpace(numero)) return false;
        var p1 = System.IO.Path.Combine(System.AppContext.BaseDirectory, "wwwroot", "img", "candidatos", $"{numero}.jpg");
        var p2 = System.IO.Path.Combine(System.IO.Directory.GetCurrentDirectory(), "wwwroot", "img", "candidatos", $"{numero}.jpg");
        return System.IO.File.Exists(p1) || System.IO.File.Exists(p2);
    }
}
@{
    ViewData["Title"] = $"Apuração 2º Turno - {Model.CargoNome} {Model.Ano}";
    var cand1 = Model.Candidatos.Count > 0 ? Model.Candidatos[0] : null;
    var cand2 = Model.Candidatos.Count > 1 ? Model.Candidatos[1] : null;
    long diffVotos = (cand1 != null && cand2 != null) ? Math.Abs(cand1.Votos - cand2.Votos) : 0;
    bool cand1Lider = cand1 != null && (cand2 == null || cand1.Votos >= cand2.Votos);
    string cor1 = cand1?.CorPartido ?? "#c4122d";
    string cor2 = cand2?.CorPartido ?? "#2563eb";
}

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <style>
        .font-display {
            font-family: 'Outfit', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            letter-spacing: -0.03em;
        }

        .font-serif-headline {
            font-family: 'Georgia', 'Times New Roman', serif;
            font-weight: 700;
            letter-spacing: -0.02em;
            line-height: 1.15;
        }

        .cand-headline-name-c1 {
            color: var(--cand1-text-color);
        }

        .cand-headline-name-c2 {
            color: var(--cand2-text-color);
        }

        .cand-headline-connector {
            color: var(--text-title);
        }

        .leaflet-tooltip-dark {
            background: rgba(11, 15, 25, 0.94) !important;
            border: 1px solid rgba(56, 189, 248, 0.45) !important;
            border-radius: 8px !important;
            padding: 8px 12px !important;
            color: #ffffff !important;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.8) !important;
            backdrop-filter: blur(10px) !important;
        }

        .filter-chip {
            background: var(--chip-bg);
            border: 1px solid var(--chip-border);
            color: var(--chip-text);
            padding: 0.4rem 0.85rem;
            border-radius: 9999px;
            text-decoration: none;
            font-size: 0.8rem;
            font-weight: 500;
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            transition: all 0.2s ease;
            white-space: nowrap;
        }

        .filter-chip:hover {
            background: var(--primary);
            color: #ffffff !important;
            border-color: var(--primary);
        }

        .filter-chip.active {
            background: var(--primary);
            color: #ffffff !important;
            border-color: var(--primary-light);
            box-shadow: 0 0 12px rgba(37, 99, 235, 0.45);
        }

        .quick-loc-pill {
            background: var(--chip-bg);
            border: 1px solid var(--border-card-subtle);
            color: var(--chip-text);
            padding: 0.22rem 0.65rem;
            border-radius: 9999px;
            font-size: 0.74rem;
            font-weight: 500;
            display: inline-flex;
            align-items: center;
            gap: 0.25rem;
            transition: all 0.15s ease;
            cursor: pointer;
            line-height: 1.25;
            white-space: nowrap;
        }

        .quick-loc-pill:hover {
            background: rgba(37, 99, 235, 0.12);
            border-color: rgba(59, 130, 246, 0.4);
            color: var(--text-title);
        }

        .quick-loc-pill.active {
            background: rgba(37, 99, 235, 0.18);
            border-color: var(--primary);
            color: var(--primary);
            font-weight: 600;
        }

        /* Card Duelo Presidencial */
        .duel-side-card {
            background: var(--bg-card);
            border: 1px solid var(--border-card);
            border-radius: 1rem;
            box-shadow: var(--card-shadow);
            color: var(--text-main);
        }

        .cand-square-avatar {
            width: 52px;
            height: 52px;
            border-radius: 0.65rem;
            object-fit: cover;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 1.25rem;
            color: #ffffff;
            flex-shrink: 0;
            overflow: hidden;
        }

        .cand-percent-display {
            color: var(--text-title);
            line-height: 1;
        }

        .cand-title-name {
            color: var(--text-title);
        }

        .duel-split-bar {
            height: 8px;
            background: var(--border-card-subtle);
            border-radius: 9999px;
            position: relative;
            display: flex;
            overflow: visible;
        }

        .threshold-50-marker {
            position: absolute;
            left: 50%;
            top: -4px;
            bottom: -4px;
            width: 2px;
            background: var(--text-title);
            box-shadow: 0 0 8px var(--text-title);
            z-index: 10;
        }

        /* Gráfico "Ao longo da apuração" */
        .chart-box {
            background: var(--bg-card-subtle);
            border: 1px solid var(--border-card-subtle);
            border-radius: 0.85rem;
            padding: 0.85rem;
        }

        /* Sidebar Regiões e Feed */
        .sidebar-card {
            background: var(--bg-card);
            border: 1px solid var(--border-card);
            border-radius: 1rem;
            box-shadow: var(--card-shadow);
            color: var(--text-main);
        }

        .region-row {
            background: var(--bg-card-subtle);
            border: 1px solid var(--border-card-subtle);
        }

        .region-name {
            color: var(--text-title);
        }

        .news-item {
            border-left: 2px solid var(--primary);
            padding-left: 0.75rem;
            margin-bottom: 0.75rem;
            position: relative;
        }

        .news-item .news-title {
            color: var(--text-main);
            font-size: 0.82rem;
            line-height: 1.35;
            font-weight: 500;
        }

        .news-item .news-meta {
            color: var(--text-secondary);
            font-size: 0.7rem;
            margin-bottom: 0.2rem;
        }

        /* Countdown Compacto */
        .countdown-strip {
            background: linear-gradient(135deg, rgba(30, 41, 59, 0.7) 0%, rgba(15, 23, 42, 0.85) 100%);
            border: 1px solid var(--border-card);
            border-radius: 0.75rem;
        }

        .border-themed {
            border-color: var(--border-card-subtle) !important;
        }
    </style>
}

<!-- Navegação e Filtro Rápido de Localidade (Drill-down Brasil -> SP -> Cidades) -->
<div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
    <div class="d-flex align-items-center flex-wrap gap-2" id="barraLocalidadesContainer">
        <span class="text-secondary small fw-bold text-uppercase me-1">
            <i class="bi bi-geo-alt-fill text-primary"></i> Localidade:
        </span>

        <a href="?ano=@Model.Ano&cargo=@Model.CargoCodigo&uf=br" 
           class="filter-chip @(Model.Uf == "br" && string.IsNullOrEmpty(Model.CodigoMunicipio) ? "active" : "")">
            <i class="bi bi-globe-americas"></i> Brasil (Total)
        </a>

        <a href="?ano=@Model.Ano&cargo=@Model.CargoCodigo&uf=sp" 
           class="filter-chip @(Model.Uf == "sp" && string.IsNullOrEmpty(Model.CodigoMunicipio) ? "active" : "")">
            <i class="bi bi-map-fill"></i> Estado de São Paulo
        </a>

        <a href="?ano=@Model.Ano&cargo=@Model.CargoCodigo&uf=sp&municipio=62910" 
           class="filter-chip @(Model.CodigoMunicipio == "62910" ? "active" : "")">
            <i class="bi bi-pin-map-fill text-warning"></i> Campinas / SP
        </a>

        @if (!string.IsNullOrEmpty(Model.CodigoMunicipio) && Model.CodigoMunicipio != "62910")
        {
            <div class="filter-chip active d-flex align-items-center gap-2">
                <i class="bi bi-building"></i>
                <span id="lblNomeCidadeAtual">@(Model.NomeMunicipio ?? Model.CodigoMunicipio)</span>
                <a href="?ano=@Model.Ano&cargo=@Model.CargoCodigo&uf=@Model.Uf" class="text-white text-decoration-none ms-1" title="Remover filtro">
                    <i class="bi bi-x-circle-fill"></i>
                </a>
            </div>
        }
    </div>

    <!-- Indicador de Status & Última Atualização -->
    <div class="d-flex align-items-center gap-2 ms-auto small">
        <span class="text-secondary" style="font-size: 0.72rem;">Atualização TSE:</span>
        <span class="font-mono fw-bold" style="color: var(--text-title);" id="lblDataTse">@(Model.DataHoraTse ?? "Aguardando totalização")</span>
    </div>
</div>

<!-- ========================================================================= -->
<!-- DASHBOARD PROFISSIONAL: 3 COLUNAS (DUELO ESQUERDA | MAPA CENTRO | FEED DIR) -->
<!-- ========================================================================= -->
<div class="row g-3 mb-3">
    <!-- ========================================== -->
    <!-- COLUNA ESQUERDA: CARD DUELO & EVOLUÇÃO     -->
    <!-- ========================================== -->
    <div class="col-12 col-xl-3 col-lg-4">
        <!-- Card Principal da Disputa Presidencial -->
        <div class="duel-side-card p-3 mb-3">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-secondary small fw-semibold" style="font-size: 0.72rem;">
                    Presidente • @(!string.IsNullOrEmpty(Model.NomeMunicipio) ? $"{Model.NomeMunicipio} ({Model.Uf.ToUpperInvariant()})" : (Model.Uf == "br" ? "Brasil" : Model.Uf.ToUpperInvariant()))
                </span>
                <span class="badge bg-secondary-subtle text-secondary small py-0 px-2 rounded-pill font-mono" style="font-size: 0.68rem;" id="badgeStatusApuracao">
                    @(Model.Finalizado ? "• 2º turno · Definido" : "• 2º turno · Ao vivo")
                </span>
            </div>

            <!-- Título em Serif com Nomes dos Candidatos Coloridos -->
            <h2 class="h5 font-serif-headline mb-3" id="lblHeadlineDuelo">
                @if (cand1 != null && cand2 != null)
                {
                    <span class="cand-headline-name-c2">@cand2.NomeUrna</span><span class="cand-headline-connector"> e </span><span class="cand-headline-name-c1">@cand1.NomeUrna</span><span class="cand-headline-connector"> vão ao 2º turno</span>
                }
                else
                {
                    <span class="cand-headline-connector">Apuração Presidencial 2º Turno</span>
                }
            </h2>

            <!-- Cards dos Dois Candidatos Lado a Lado -->
            <div class="d-flex align-items-center justify-content-between gap-2 mb-3">
                <!-- Candidato 1 -->
                @if (cand1 != null)
                {
                    <div class="d-flex align-items-center gap-2 flex-grow-1">
                        <div class="cand-square-avatar" style="background: @cor1;">
                            @if (!string.IsNullOrWhiteSpace(cand1.FotoUrl))
                            {
                                <img src="@cand1.FotoUrl" alt="@cand1.NomeUrna" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                                <div style="display: none;">@(cand1.NomeUrna.Substring(0, Math.Min(2, cand1.NomeUrna.Length)))</div>
                            }
                            else if (FotoExiste(cand1.Numero))
                            {
                                <img src="/img/candidatos/@(cand1.Numero).jpg" alt="@cand1.NomeUrna" style="width: 100%; height: 100%; object-fit: cover;" />
                            }
                            else
                            {
                                <div>@(cand1.NomeUrna.Substring(0, Math.Min(2, cand1.NomeUrna.Length)))</div>
                            }
                        </div>
                        <div>
                            <div class="cand-title-name fw-bold small lh-1 mb-1">@cand1.NomeUrna</div>
                            <div class="small font-mono fw-bold" style="font-size: 0.72rem; color: @cor1;">@cand1.Partido @cand1.Numero</div>
                        </div>
                    </div>
                }

                <!-- Candidato 2 -->
                @if (cand2 != null)
                {
                    <div class="d-flex align-items-center justify-content-end gap-2 flex-grow-1 text-end">
                        <div>
                            <div class="cand-title-name fw-bold small lh-1 mb-1">@cand2.NomeUrna</div>
                            <div class="small font-mono fw-bold" style="font-size: 0.72rem; color: @cor2;">@cand2.Partido @cand2.Numero</div>
                        </div>
                        <div class="cand-square-avatar" style="background: @cor2;">
                            @if (!string.IsNullOrWhiteSpace(cand2.FotoUrl))
                            {
                                <img src="@cand2.FotoUrl" alt="@cand2.NomeUrna" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                                <div style="display: none;">@(cand2.NomeUrna.Substring(0, Math.Min(2, cand2.NomeUrna.Length)))</div>
                            }
                            else if (FotoExiste(cand2.Numero))
                            {
                                <img src="/img/candidatos/@(cand2.Numero).jpg" alt="@cand2.NomeUrna" style="width: 100%; height: 100%; object-fit: cover;" />
                            }
                            else
                            {
                                <div>@(cand2.NomeUrna.Substring(0, Math.Min(2, cand2.NomeUrna.Length)))</div>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- Percentuais Grandes -->
            <div class="d-flex align-items-baseline justify-content-between mb-2">
                <div class="text-start">
                    <div class="display-6 fw-bold font-display cand-percent-display" id="cand1Perc">
                        @(cand1?.Percentual.ToString("F2") ?? "0,00")<span class="fs-6 text-secondary">%</span>
                    </div>
                    <div class="small font-mono text-secondary" style="font-size: 0.75rem;" id="cand1Votos">
                        @(cand1?.Votos.ToString("N0") ?? "0") votos
                    </div>
                </div>

                <div class="text-end">
                    <div class="display-6 fw-bold font-display cand-percent-display" id="cand2Perc">
                        @(cand2?.Percentual.ToString("F2") ?? "0,00")<span class="fs-6 text-secondary">%</span>
                    </div>
                    <div class="small font-mono text-secondary" style="font-size: 0.75rem;" id="cand2Votos">
                        @(cand2?.Votos.ToString("N0") ?? "0") votos
                    </div>
                </div>
            </div>

            <!-- Barra Segmentada com Marcador de 50% -->
            <div class="duel-split-bar mb-2">
                <div class="threshold-50-marker"></div>
                <div id="barCand1" style="width: @(cand1?.Percentual.ToString("F2", System.Globalization.CultureInfo.InvariantCulture) ?? "50")%; background-color: @cor1; border-radius: 9999px 0 0 9999px;"></div>
                <div id="barCand2" style="width: @(cand2?.Percentual.ToString("F2", System.Globalization.CultureInfo.InvariantCulture) ?? "50")%; background-color: @cor2; border-radius: 0 9999px 9999px 0; margin-left: auto;"></div>
            </div>

            <!-- Diferença e Meta -->
            <div class="d-flex align-items-center justify-content-between text-secondary small py-2 border-top border-themed mt-2" style="font-size: 0.75rem;">
                <span>Diferença: <strong class="font-mono" style="color: var(--text-title);" id="lblDiffPontos">@Math.Abs((cand1?.Percentual ?? 0) - (cand2?.Percentual ?? 0)).ToString("F2") pts</strong> (@diffVotos.ToString("N0") votos)</span>
                <span>2º turno: <strong class="text-warning">25/10</strong></span>
            </div>

            <!-- Resumo dos Votos Válidos, Comparecimento e Brancos/Nulos -->
            <div class="row g-2 pt-2 border-top border-themed text-center" style="font-size: 0.75rem;">
                <div class="col-4">
                    <div class="text-secondary" style="font-size: 0.68rem;">Votos válidos</div>
                    <div class="fw-bold font-mono" style="color: var(--text-title);" id="lblVotosValidos">@Model.VotosValidos.ToString("N0")</div>
                </div>
                <div class="col-4">
                    <div class="text-secondary" style="font-size: 0.68rem;">Comparecimento</div>
                    <div class="fw-bold font-mono" style="color: var(--text-title);" id="lblPercComparecimento">@Model.PercentualComparecimento.ToString("F1")%</div>
                </div>
                <div class="col-4">
                    <div class="text-secondary" style="font-size: 0.68rem;">Brancos e nulos</div>
                    <div class="fw-bold font-mono" style="color: var(--text-title);" id="lblPercBrancosNulos">@((Model.PercentualVotosBrancos + Model.PercentualVotosNulos).ToString("F1"))%</div>
                </div>
            </div>
        </div>

        <!-- Card "Ao longo da apuração" (Gráfico de Linha Interativo) -->
        <div class="sidebar-card p-3 mb-3">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="small fw-bold" style="color: var(--text-title);">Ao longo da apuração</span>
                <div class="d-flex align-items-center gap-2 small" style="font-size: 0.7rem;">
                    <span style="color: @cor1;">■ @(cand1?.NomeUrna ?? "C1")</span>
                    <span style="color: @cor2;">■ @(cand2?.NomeUrna ?? "C2")</span>
                </div>
            </div>

            <!-- Gráfico Vetorial em SVG -->
            <div class="chart-box">
                <svg viewBox="0 0 300 130" style="width: 100%; height: auto; overflow: visible;">
                    <!-- Linhas horizontais de grade (38% a 54%) -->
                    <line x1="25" y1="20" x2="295" y2="20" stroke="var(--chart-grid)" stroke-dasharray="2,2" />
                    <text x="5" y="23" fill="var(--chart-text)" font-size="8" font-family="monospace">54%</text>

                    <line x1="25" y1="45" x2="295" y2="45" stroke="var(--chart-grid)" stroke-dasharray="2,2" />
                    <text x="5" y="48" fill="var(--chart-text)" font-size="8" font-family="monospace">50%</text>

                    <line x1="25" y1="70" x2="295" y2="70" stroke="var(--chart-grid)" stroke-dasharray="2,2" />
                    <text x="5" y="73" fill="var(--chart-text)" font-size="8" font-family="monospace">46%</text>

                    <line x1="25" y1="95" x2="295" y2="95" stroke="var(--chart-grid)" stroke-dasharray="2,2" />
                    <text x="5" y="98" fill="var(--chart-text)" font-size="8" font-family="monospace">42%</text>

                    <!-- Curva Cand 2 (Azul/PL) -->
                    <path d="M 30,50 Q 80,30 150,42 T 290,62" fill="none" stroke="@cor2" stroke-width="2.5" />
                    <circle cx="290" cy="62" r="3.5" fill="@cor2" />

                    <!-- Curva Cand 1 (Vermelho/PT) -->
                    <path d="M 30,85 Q 80,105 150,98 T 290,75" fill="none" stroke="@cor1" stroke-width="2.5" />
                    <circle cx="290" cy="75" r="3.5" fill="@cor1" />

                    <!-- Eixo X (0% a 100%) -->
                    <text x="30" y="120" fill="var(--chart-text)" font-size="8">0% das seções</text>
                    <text x="145" y="120" fill="var(--chart-text)" font-size="8" text-anchor="middle">50%</text>
                    <text x="290" y="120" fill="var(--chart-text)" font-size="8" text-anchor="end">100%</text>
                </svg>
            </div>
        </div>

        <!-- Contagem Regressiva 2º Turno (25/10) -->
        <div class="countdown-strip p-3 text-center">
            <div class="small text-secondary mb-1" style="font-size: 0.72rem;">
                <i class="bi bi-alarm text-info me-1"></i> Abertura das urnas do 2º turno (25/10):
            </div>
            <div class="d-flex align-items-center justify-content-center gap-2 font-mono fw-bold fs-5" style="color: var(--text-title);" id="timerDigitsContainer">
                <span id="cdDias">00</span><small class="text-secondary fs-6">d</small>
                <span id="cdHoras">00</span><small class="text-secondary fs-6">h</small>
                <span id="cdMinutos">00</span><small class="text-secondary fs-6">m</small>
                <span id="cdSegundos" class="text-warning">00</span><small class="text-secondary fs-6">s</small>
            </div>
        </div>
    </div>

    <!-- ========================================== -->
    <!-- COLUNA CENTRAL: MAPA & FILTROS & SCRUBBER  -->
    <!-- ========================================== -->
    <div class="col-12 col-xl-6 col-lg-5">
        @await Html.PartialAsync("_MapaBrasil", Model)
    </div>

    <!-- ========================================== -->
    <!-- COLUNA DIREITA: POR REGIÃO & FEED AO VIVO  -->
    <!-- ========================================== -->
    <div class="col-12 col-xl-3 col-lg-3">
        <!-- Card 1: Por Região (Quem lidera para presidente) -->
        <div class="sidebar-card p-3 mb-3">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="small fw-bold" style="color: var(--text-title);">Por região</span>
                <span class="text-secondary" style="font-size: 0.7rem;">Quem lidera</span>
            </div>

            <div class="d-flex flex-column gap-2" style="font-size: 0.78rem;">
                <!-- Norte -->
                <div class="d-flex align-items-center justify-content-between p-1 rounded region-row">
                    <div class="d-flex align-items-center gap-2">
                        <span class="fw-semibold region-name" style="width: 75px;">Norte</span>
                        <span class="badge bg-secondary-subtle text-secondary py-0" style="font-size: 0.65rem;">100%</span>
                    </div>
                    <div class="d-flex align-items-center gap-1 font-mono">
                        <span class="badge" style="background: @cor2; color: #fff;">PL 49,2%</span>
                        <span class="text-info small" style="font-size: 0.7rem;">+3,7</span>
                    </div>
                </div>

                <!-- Nordeste -->
                <div class="d-flex align-items-center justify-content-between p-1 rounded region-row">
                    <div class="d-flex align-items-center gap-2">
                        <span class="fw-semibold region-name" style="width: 75px;">Nordeste</span>
                        <span class="badge bg-secondary-subtle text-secondary py-0" style="font-size: 0.65rem;">100%</span>
                    </div>
                    <div class="d-flex align-items-center gap-1 font-mono">
                        <span class="badge" style="background: @cor1; color: #fff;">PT 63,8%</span>
                        <span class="text-danger small" style="font-size: 0.7rem;">+27,6</span>
                    </div>
                </div>

                <!-- Centro-Oeste -->
                <div class="d-flex align-items-center justify-content-between p-1 rounded region-row">
                    <div class="d-flex align-items-center gap-2">
                        <span class="fw-semibold region-name" style="width: 75px;">Centro-O.</span>
                        <span class="badge bg-secondary-subtle text-secondary py-0" style="font-size: 0.65rem;">100%</span>
                    </div>
                    <div class="d-flex align-items-center gap-1 font-mono">
                        <span class="badge" style="background: @cor2; color: #fff;">PL 56,5%</span>
                        <span class="text-info small" style="font-size: 0.7rem;">+13,0</span>
                    </div>
                </div>

