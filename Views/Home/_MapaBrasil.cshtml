@model apuracao.johnmarlon.com.br.Models.ApuracaoViewModel

<div class="map-container mb-4" id="boxMapaBrasil">
    <!-- Cabeçalho do Mapa com Seletor e Status -->
    <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
        <div class="d-flex align-items-center gap-2">
            <span class="fw-bold text-white small text-uppercase" id="lblTituloMapaHeader">
                <i class="bi bi-geo-alt-fill me-1 text-primary"></i> Mapa da Votação
            </span>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle" id="lblMapaTitulo">
                Brasil (27 UFs)
            </span>
        </div>

        <div class="d-flex align-items-center gap-2">
            <div class="btn-group btn-group-sm" role="group">
                <button type="button" class="btn btn-outline-primary active py-1 px-3 small fw-semibold" id="btnToggleMapaBrasil" onclick="alternarVisaoMapa('brasil')">
                    <i class="bi bi-globe-americas me-1 text-primary"></i> Brasil
                </button>
                <button type="button" class="btn btn-outline-primary py-1 px-3 small fw-semibold" id="btnToggleMapaSp" onclick="alternarVisaoMapa('sp')">
                    <i class="bi bi-building me-1"></i> SP & Cidades
                </button>
            </div>
            <button type="button" class="btn btn-sm btn-outline-info py-1 px-2" id="btnVoltarNacional" onclick="alternarVisaoMapa('brasil')" style="display: none;" title="Voltar ao mapa do Brasil">
                <i class="bi bi-arrow-left me-1"></i> Brasil Inteiro
            </button>
        </div>
    </div>

    <!-- Visão 1: Mapa do Brasil (Nacional + Exterior) -->
    <div id="visaoMapaBrasil">
        <!-- Card do Exterior (ZZ - Urnas no Mundo) -->
        <div class="card-exterior-zz p-2 px-3 rounded-3 mb-2 d-flex align-items-center justify-content-between" 
             id="cardExteriorZz" 
             onclick="window.location.href='?ano=@Model.Ano&cargo=@Model.CargoCodigo&uf=zz';"
             title="Clique para ver os votos dos brasileiros no exterior (ZZ)">
            <div class="d-flex align-items-center gap-2">
                <div class="pulse-globe text-info fs-5" id="iconeGloboZz">
                    <i class="bi bi-globe-americas"></i>
                </div>
                <div class="text-start">
                    <div class="fw-bold text-white small d-flex align-items-center gap-1" id="boxTituloZz">
                        <span>Urnas no Mundo (Exterior - ZZ)</span>
                        <span class="badge bg-secondary-subtle text-secondary py-0 px-1" id="lblPercZz" style="font-size: 0.65rem;">Carregando...</span>
                    </div>
                    <div class="small text-secondary" id="lblLiderZz" style="font-size: 0.72rem;">
                        Consultando seções consulares...
                    </div>
                </div>
            </div>
            <div class="text-end" id="boxVotosZz">
                <span class="badge bg-primary px-2 py-1 font-mono" id="lblVotosLiderZz" style="font-size: 0.78rem;">--</span>
            </div>
        </div>

        <!-- Placar Resumido de Estados Liderados -->
        <div class="placar-estados-bar p-2 mb-2 rounded-2 d-flex align-items-center justify-content-between flex-wrap gap-2" 
             id="placarEstadosContainer">
            <div class="small text-secondary w-100 d-flex align-items-center justify-content-between" id="placarResumo">
                <span><i class="bi bi-bar-chart-fill text-warning me-1"></i> Placar de Estados:</span>
                <span class="spinner-border spinner-border-sm text-primary" role="status"></span>
            </div>
        </div>

        <!-- SVG Vetorial Cartográfico Autêntico do Brasil (27 UFs) -->
        <div class="position-relative svg-brasil-wrapper" style="overflow: visible;">
            <svg id="svgMapaBrasil" viewBox="0 0 1000 912" class="w-100" style="max-height: 380px; filter: drop-shadow(0 6px 18px rgba(0,0,0,0.45));">
