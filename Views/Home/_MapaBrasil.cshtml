@model apuracao.johnmarlon.com.br.Models.ApuracaoViewModel

<div class="map-container mb-4" id="boxMapaBrasil">
    <!-- Cabeçalho do Mapa com Seletor e Status -->
    <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
        <div class="d-flex align-items-center gap-2">
            <span class="fw-bold text-white small text-uppercase" id="lblTituloMapaHeader">
                <i class="bi bi-geo-alt-fill me-1 text-primary"></i> Mapa Interativo
            </span>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle" id="lblLeafletModoAtual">
                Brasil • 27 UFs
            </span>
        </div>

        <div class="d-flex align-items-center gap-2 flex-wrap">
            <div class="btn-group btn-group-sm" role="group">
                <button type="button" class="btn btn-outline-primary active py-1 px-2 px-md-3 small fw-semibold" id="btnLeafletBrasil" onclick="MapaEleicoesLeaflet.alternarVisao('brasil')">
                    <i class="bi bi-globe-americas me-1 text-primary"></i> Brasil
                </button>
                <button type="button" class="btn btn-outline-primary py-1 px-2 px-md-3 small fw-semibold" id="btnLeafletSp" onclick="MapaEleicoesLeaflet.alternarVisao('sp')">
                    <i class="bi bi-building me-1"></i> SP & Cidades
                </button>
                <button type="button" class="btn btn-outline-primary py-1 px-2 px-md-3 small fw-semibold" id="btnLeafletExterior" onclick="MapaEleicoesLeaflet.alternarVisao('exterior')">
                    <i class="bi bi-globe me-1 text-info"></i> Urnas no Mundo (ZZ)
                </button>
            </div>

            <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2" onclick="MapaEleicoesLeaflet.alternarVisao(MapaEleicoesLeaflet.visaoAtual)" title="Resetar posição">
                <i class="bi bi-arrow-counterclockwise"></i>
            </button>
        </div>
    </div>

    <!-- Card do Exterior (ZZ - Urnas no Mundo) -->
    <div class="card-exterior-zz p-2 px-3 rounded-3 mb-3 d-flex align-items-center justify-content-between" 
         id="cardExteriorZz" 
         onclick="MapaEleicoesLeaflet.alternarVisao('exterior')"
         title="Clique para ver o mapa mundial com os votos dos brasileiros no exterior (ZZ)">
        <div class="d-flex align-items-center gap-2">
            <div class="pulse-globe text-info fs-5" id="iconeGloboZz">
                <i class="bi bi-globe-americas"></i>
            </div>
            <div class="text-start">
                <div class="fw-bold text-white small d-flex align-items-center gap-1" id="boxTituloZz">
                    <span>Urnas no Mundo (Exterior - ZZ)</span>
                    <span class="badge bg-secondary-subtle text-secondary py-0 px-1" id="lblPercZz" style="font-size: 0.65rem;">Carregando...</span>
                </div>
                <div class="small text-secondary" id="lblLiderZz" style="font-size: 0.72rem;">
                    Consultando seções consulares...
                </div>
            </div>
        </div>
        <div class="text-end" id="boxVotosZz">
            <span class="badge bg-primary px-2 py-1 font-mono" id="lblVotosLiderZz" style="font-size: 0.78rem;">--</span>
        </div>
    </div>

    <!-- Placar Resumido de Estados Liderados -->
    <div class="placar-estados-bar p-2 mb-3 rounded-2 d-flex align-items-center justify-content-between flex-wrap gap-2" 
         id="placarEstadosContainer">
        <div class="small text-secondary w-100 d-flex align-items-center justify-content-between" id="placarResumo">
            <span><i class="bi bi-bar-chart-fill text-warning me-1"></i> Placar de Estados:</span>
            <span class="spinner-border spinner-border-sm text-primary" role="status"></span>
        </div>
    </div>

    <!-- Container do Mapa Interativo Leaflet (CartoDB Dark Matter / Positron) -->
    <div class="position-relative" style="border-radius: 1rem; overflow: hidden; border: 1px solid rgba(255, 255, 255, 0.12); box-shadow: 0 16px 36px rgba(0, 0, 0, 0.6);">
        <div id="mapaInterativoLeaflet" style="height: 460px; width: 100%; z-index: 10;"></div>

        <!-- Badge de Orientação Flutuante no Mapa -->
        <div class="position-absolute bottom-0 start-0 m-3 px-3 py-1 rounded-pill small" style="z-index: 500; background: rgba(15, 23, 42, 0.85); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.15); color: #94a3b8; font-size: 0.72rem; pointer-events: none;">
            <i class="bi bi-info-circle me-1 text-info"></i> Toque ou use o scroll para aproximar até o nível de cidades
        </div>
    </div>

    <!-- Painel de Busca Instantânea de Cidades de SP -->
    <div class="mt-3 p-3 rounded-3" style="background: rgba(15, 23, 42, 0.7); border: 1px solid rgba(255, 255, 255, 0.08);">
        <div class="d-flex align-items-center justify-content-between mb-2">
            <span class="small text-white fw-bold">
                <i class="bi bi-search me-1 text-primary"></i> Filtrar Município de SP:
            </span>
            <span class="badge bg-secondary-subtle text-secondary small" id="lblTotalCidadesFiltradas">@Model.MunicipiosDisponiveis.Count cidades</span>
        </div>
        <div class="input-group input-group-sm mb-2">
            <span class="input-group-text bg-transparent border-secondary text-secondary"><i class="bi bi-search"></i></span>
            <input type="text" id="filtroCidadesInput" class="form-control bg-dark text-white border-secondary" placeholder="Digite o nome (ex: Campinas, Santos, Bauru...)" oninput="filtrarListaCidades(this.value)" autocomplete="off" />
            <button class="btn btn-outline-secondary" type="button" onclick="document.getElementById('filtroCidadesInput').value=''; filtrarListaCidades('');">Limpar</button>
        </div>

        <div id="listaCidadesScroll" class="d-flex flex-wrap gap-2" style="max-height: 140px; overflow-y: auto;">
            <button type="button" 
                    class="btn btn-sm @(string.IsNullOrEmpty(Model.CodigoMunicipio) ? "btn-primary" : "btn-outline-secondary") py-1 px-2 small item-cidade-pill"
                    data-nome="todo o estado de sp"
                    onclick="selecionarCidadePin('', 'Todo o Estado de SP')">
                <i class="bi bi-map-fill me-1"></i> Todo o Estado de SP
            </button>
            @foreach (var c in Model.MunicipiosDisponiveis)
            {
                bool isSelected = Model.CodigoMunicipio == c.Codigo;
                <button type="button" 
                        class="btn btn-sm @(isSelected ? "btn-primary" : (c.Destaque ? "btn-outline-primary" : "btn-outline-secondary")) py-1 px-2 small item-cidade-pill"
                        data-codigo="@c.Codigo"
                        data-nome="@c.Nome.ToLowerInvariant()"
                        onclick="selecionarCidadePin('@c.Codigo', '@c.Nome')">
                    @if (c.Destaque)
                    {
                        <i class="bi bi-star-fill text-warning me-1"></i>
                    }
                    @c.Nome
                </button>
            }
        </div>
    </div>
</div>

<script>
    function filtrarListaCidades(termo) {
        const query = (termo || '').toLowerCase().trim();
        const pills = document.querySelectorAll('#listaCidadesScroll .item-cidade-pill');
        let visiveis = 0;
        pills.forEach(pill => {
            const nome = pill.getAttribute('data-nome') || '';
            if (!query || nome.includes(query)) {
                pill.style.display = 'inline-flex';
                visiveis++;
            } else {
                pill.style.display = 'none';
            }
        });
        const lbl = document.getElementById('lblTotalCidadesFiltradas');
        if (lbl) lbl.innerText = visiveis + ' cidades';
    }

    function selecionarCidadePin(codigo, nome) {
        const url = new URL(window.location.href);
        url.searchParams.set('ano', '@Model.Ano');
        url.searchParams.set('cargo', '@Model.CargoCodigo');
        url.searchParams.set('uf', 'sp');
        if (codigo) {
            url.searchParams.set('municipio', codigo);
        } else {
            url.searchParams.delete('municipio');
        }
        window.location.href = url.toString();
    }
</script>