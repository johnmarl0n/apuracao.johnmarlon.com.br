@model apuracao.johnmarlon.com.br.Models.ApuracaoViewModel

<div class="map-container mb-0 d-flex flex-column h-100" id="boxMapaBrasil" style="gap: 0.25rem;">
    <!-- Barra Superior de Modos e Filtros (Inspirado no Pandora / SeuImposto) -->
    <div class="d-flex align-items-center justify-content-between flex-nowrap gap-2 flex-shrink-0" style="min-height: 32px;">
        <div class="d-flex align-items-center gap-2 flex-nowrap">
            <div class="btn-group btn-group-sm flex-nowrap" role="group">
                <button type="button" class="btn btn-outline-secondary active py-1 px-2 small fw-semibold text-nowrap" id="btnFiltroMun" onclick="MapaEleicoesLeaflet.alternarVisao('sp')">
                    Municípios
                </button>
                <button type="button" class="btn btn-outline-secondary py-1 px-2 small fw-semibold text-nowrap" id="btnFiltroEstados" onclick="MapaEleicoesLeaflet.alternarVisao('brasil')">
                    Estados
                </button>
                <button type="button" class="btn btn-outline-secondary py-1 px-2 small fw-semibold text-nowrap" onclick="MapaEleicoesLeaflet.alternarVisao('exterior')">
                    <i class="bi bi-globe me-1 text-info"></i> Exterior (ZZ)
                </button>
            </div>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle text-nowrap d-none d-md-inline-block" id="lblLeafletModoAtual">
                Brasil • 27 UFs
            </span>
        </div>

        <!-- Legenda da Vantagem dos Candidatos (PL vs PT) -->
        <div class="d-flex align-items-center gap-2 gap-xl-3 small flex-nowrap" style="font-size: 0.75rem;">
            <div class="d-flex align-items-center gap-1 text-nowrap">
                <span style="width: 8px; height: 8px; border-radius: 50%; background: #0c326f; display: inline-block;"></span>
                <span class="fw-bold" style="color: var(--text-title);">PL</span>
                <span class="text-secondary">2.905 mun.</span>
            </div>
            <div class="d-flex align-items-center gap-1 text-nowrap">
                <span style="width: 8px; height: 8px; border-radius: 50%; background: #c4122d; display: inline-block;"></span>
                <span class="fw-bold" style="color: var(--text-title);">PT</span>
                <span class="text-secondary">2.665 mun.</span>
            </div>
            <div class="d-none d-xxl-flex align-items-center gap-1 text-secondary text-nowrap" style="font-size: 0.7rem;">
                <span>vantagem:</span>
                <span class="px-1 rounded" style="background: rgba(12, 50, 111, 0.5); color: #93c5fd;">até 10</span>
                <span class="px-1 rounded" style="background: rgba(12, 50, 111, 0.8); color: #ffffff;">25</span>
                <span class="px-1 rounded" style="background: rgba(196, 18, 45, 0.8); color: #ffffff;">45+ pts</span>
            </div>
        </div>
    </div>

    <!-- Container do Mapa Interativo Leaflet (CartoDB Dark Matter / Positron) -->
    <div class="position-relative map-wrapper-leaflet" style="flex: 1 1 0%; min-height: 0; height: 0; border-radius: 0.85rem; overflow: hidden; border: 1px solid var(--border-card); box-shadow: var(--card-shadow);">
        <div id="mapaInterativoLeaflet" class="mapa-leaflet-frame" style="width: 100%; height: 100%; min-height: 0;"></div>

        <!-- Badge de Orientação Flutuante no Mapa -->
        <div class="position-absolute bottom-0 start-0 m-2 px-3 py-1 rounded-pill small" style="z-index: 500; background: var(--bg-card); backdrop-filter: blur(10px); border: 1px solid var(--border-card); color: var(--text-secondary); font-size: 0.72rem; pointer-events: none; box-shadow: var(--card-shadow-sm);">
            <i class="bi bi-cursor me-1 text-primary"></i> Clique em um estado para ver as cidades ou use o zoom
        </div>

        <!-- Botão Voltar ao Brasil Flutuante -->
        <button type="button" 
                class="btn btn-sm btn-header-action position-absolute top-0 start-0 m-2 rounded-pill shadow px-3 py-1 d-flex align-items-center gap-1" 
                style="z-index: 500;"
                onclick="MapaEleicoesLeaflet.alternarVisao('brasil')" 
                title="Voltar à visão do Brasil">
            <i class="bi bi-globe-americas text-primary"></i> <span class="small fw-semibold" style="color: var(--text-main);">Brasil Geral</span>
        </button>
    </div>

    <!-- Barra Inferior de Linha do Tempo e Apuração (Timeline Scrubber) -->
    <div class="px-3 rounded-3 d-flex align-items-center justify-content-between flex-nowrap gap-2 timeline-bar-box flex-shrink-0" style="background: var(--bg-card); border: 1px solid var(--border-card); font-size: 0.76rem; height: 36px; min-height: 36px;">
        <div class="d-flex align-items-center gap-2 flex-shrink-0">
            <span class="font-mono fw-bold timeline-clock-text" style="color: var(--text-title);" id="lblLiveClockScrubber">19:04:32</span>
            <span class="badge bg-secondary-subtle text-secondary small py-0 px-1 d-none d-sm-inline">Brasília</span>
        </div>

        <div class="d-flex align-items-center gap-2 flex-grow-1 mx-2" style="max-width: 340px; min-width: 100px;">
            <span class="text-secondary small font-mono" id="lblScrubberMin">0%</span>
            <input type="range" class="form-range flex-grow-1" min="0" max="100" value="100" id="rangeScrubberApuracao" style="height: 4px;" title="Navegar no histórico da apuração" />
            <span class="fw-bold font-mono" style="color: var(--text-title);" id="lblScrubberCurrent">100%</span>
        </div>

        <div class="d-flex align-items-center gap-2 flex-shrink-0">
            <span class="small font-mono text-secondary d-flex align-items-center gap-1" id="lblContainerPresenca">
                <i class="bi bi-eye text-primary"></i> 
                <strong style="color: var(--text-title);" id="lblOnlineCount">1 pessoa</strong> agora
            </span>
            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill py-0 px-2 font-mono" style="font-size: 0.68rem;">
                <span class="pulse-nav me-1"></span> AO VIVO
            </span>
        </div>
    </div>

</div>

<!-- Modal Detalhado de Zonas Eleitorais do Município Clicado -->
<div class="modal fade" id="modalZonasEleitorais" tabindex="-1" aria-labelledby="modalZonasEleitoraisLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content" style="background: var(--bg-card); border: 1px solid var(--border-card); box-shadow: var(--card-shadow); color: var(--text-main);">
            <div class="modal-header border-bottom border-themed pb-3">
                <div class="d-flex align-items-center gap-2">
                    <div class="rounded-circle p-2 d-flex align-items-center justify-content-center" style="background: rgba(37, 99, 235, 0.15); color: #38bdf8;">
                        <i class="bi bi-geo-alt-fill fs-5"></i>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2">
                            <h5 class="modal-title fw-bold mb-0" style="color: var(--text-title);" id="modalMunNome">Campinas</h5>
                            <span class="badge bg-primary text-white font-mono" id="modalMunUf">SP</span>
                        </div>
                        <div class="small text-secondary" style="font-size: 0.75rem;">
                            Código TSE: <strong id="modalMunCod" class="font-mono" style="color: var(--text-title);">62910</strong> • 100% das seções apuradas
                        </div>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-3">
                <!-- Placar Geral do Município -->
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <div class="p-3 rounded-3 text-center" style="background: rgba(196, 18, 45, 0.08); border: 1px solid rgba(196, 18, 45, 0.25);">
                            <div class="small fw-semibold text-danger mb-1">■ Lula (PT)</div>
                            <div class="fs-4 fw-bold font-mono" style="color: var(--text-title);" id="modalPercCand1">46.5%</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 rounded-3 text-center" style="background: rgba(12, 50, 111, 0.1); border: 1px solid rgba(59, 130, 246, 0.25);">
                            <div class="small fw-semibold text-primary mb-1">■ Bolsonaro (PL)</div>
                            <div class="fs-4 fw-bold font-mono" style="color: var(--text-title);" id="modalPercCand2">53.5%</div>
                        </div>
                    </div>
                </div>

                <!-- Tabela de Zonas Eleitorais -->
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="small fw-bold text-uppercase" style="color: var(--text-title);">
                        <i class="bi bi-diagram-3-fill text-warning me-1"></i> Detalhamento por Zona Eleitoral:
                    </span>
                    <span class="small text-secondary" style="font-size: 0.72rem;">Distribuição de Votos por Cartório</span>
                </div>

                <div class="table-responsive rounded-2" style="border: 1px solid var(--border-card-subtle);">
                    <table class="table table-hover mb-0 align-middle" style="font-size: 0.8rem; color: var(--text-main);">
                        <thead class="text-secondary small">
                            <tr>
                                <th>Zona</th>
                                <th>Seções</th>
                                <th>Eleitorado</th>
                                <th>Lula (PT)</th>
                                <th>Bolsonaro (PL)</th>
                            </tr>
                        </thead>
                        <tbody id="modalTabelaZonasBody">
                            <!-- Inserido dinamicamente pelo Leaflet -->
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer border-top border-secondary border-opacity-25 py-2 d-flex justify-content-between">
                <span class="small text-secondary" style="font-size: 0.72rem;">
                    <i class="bi bi-shield-check text-success me-1"></i> Dados oficiais de totalização da Justiça Eleitoral
                </span>
                <button type="button" class="btn btn-sm btn-primary px-3 rounded-pill" id="btnModalAbrirApuracaoMun">
                    <i class="bi bi-arrow-up-circle-fill me-1"></i> Ver a Página da Cidade
                </button>
            </div>
        </div>
    </div>
</div>