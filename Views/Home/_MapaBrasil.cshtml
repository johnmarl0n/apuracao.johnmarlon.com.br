@model apuracao.johnmarlon.com.br.Models.ApuracaoViewModel

<div class="map-container mb-4" id="boxMapaBrasil">
    <!-- Barra Superior de Modos e Filtros (Inspirado no Pandora / SeuImposto) -->
    <div class="d-flex align-items-center justify-content-between mb-2 flex-wrap gap-2">
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <div class="btn-group btn-group-sm" role="group">
                <button type="button" class="btn btn-outline-secondary active py-1 px-2 small fw-semibold" id="btnFiltroMun" onclick="MapaEleicoesLeaflet.alternarVisao('sp')">
                    Municípios
                </button>
                <button type="button" class="btn btn-outline-secondary py-1 px-2 small fw-semibold" id="btnFiltroEstados" onclick="MapaEleicoesLeaflet.alternarVisao('brasil')">
                    Estados
                </button>
                <button type="button" class="btn btn-outline-secondary py-1 px-2 small fw-semibold" onclick="MapaEleicoesLeaflet.alternarVisao('exterior')">
                    <i class="bi bi-globe me-1 text-info"></i> Exterior (ZZ)
                </button>
            </div>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle" id="lblLeafletModoAtual">
                Brasil • 27 UFs
            </span>
        </div>

        <!-- Legenda da Vantagem dos Candidatos (PL vs PT) -->
        <div class="d-flex align-items-center gap-3 small flex-wrap" style="font-size: 0.75rem;">
            <div class="d-flex align-items-center gap-1">
                <span style="width: 8px; height: 8px; border-radius: 50%; background: #0c326f; display: inline-block;"></span>
                <span class="text-white fw-bold">PL</span>
                <span class="text-secondary">2.905 mun.</span>
            </div>
            <div class="d-flex align-items-center gap-1">
                <span style="width: 8px; height: 8px; border-radius: 50%; background: #c4122d; display: inline-block;"></span>
                <span class="text-white fw-bold">PT</span>
                <span class="text-secondary">2.665 mun.</span>
            </div>
            <div class="d-none d-md-flex align-items-center gap-1 text-secondary" style="font-size: 0.7rem;">
                <span>vantagem:</span>
                <span class="px-1 rounded" style="background: rgba(12, 50, 111, 0.5); color: #93c5fd;">até 10</span>
                <span class="px-1 rounded" style="background: rgba(12, 50, 111, 0.8); color: #ffffff;">25</span>
                <span class="px-1 rounded" style="background: rgba(196, 18, 45, 0.8); color: #ffffff;">45+ pts</span>
            </div>
        </div>
    </div>

    <!-- Container do Mapa Interativo Leaflet (CartoDB Dark Matter / Positron) -->
    <div class="position-relative" style="border-radius: 1rem; overflow: hidden; border: 1px solid rgba(255, 255, 255, 0.12); box-shadow: 0 16px 36px rgba(0, 0, 0, 0.6);">
        <div id="mapaInterativoLeaflet" style="height: 480px; width: 100%; z-index: 10;"></div>

        <!-- Badge de Orientação Flutuante no Mapa -->
        <div class="position-absolute bottom-0 start-0 m-3 px-3 py-1 rounded-pill small" style="z-index: 500; background: rgba(15, 23, 42, 0.88); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.15); color: #94a3b8; font-size: 0.72rem; pointer-events: none;">
            <i class="bi bi-cursor me-1 text-info"></i> Clique em um estado para ver as cidades ou use o zoom
        </div>

        <!-- Botão Voltar ao Brasil Flutuante -->
        <button type="button" 
                class="btn btn-sm btn-dark position-absolute top-0 start-0 m-3 rounded-pill shadow px-3 py-1 d-flex align-items-center gap-1" 
                style="z-index: 500; border: 1px solid rgba(255,255,255,0.2); background: rgba(15,23,42,0.9); backdrop-filter: blur(8px);"
                onclick="MapaEleicoesLeaflet.alternarVisao('brasil')" 
                title="Voltar à visão do Brasil">
            <i class="bi bi-globe-americas text-primary"></i> <span class="small fw-semibold text-white">Brasil Geral</span>
        </button>
    </div>

    <!-- Barra Inferior de Linha do Tempo e Apuração (Timeline Scrubber) -->
    <div class="mt-2 p-2 px-3 rounded-3 d-flex align-items-center justify-content-between flex-wrap gap-2" style="background: rgba(15, 23, 42, 0.7); border: 1px solid rgba(255, 255, 255, 0.08); font-size: 0.78rem;">
        <div class="d-flex align-items-center gap-2">
            <span class="font-mono text-white fw-bold" id="lblLiveClockScrubber">19:04:32</span>
            <span class="badge bg-secondary-subtle text-secondary small py-0 px-1">Horário de Brasília</span>
        </div>

        <div class="d-flex align-items-center gap-2 flex-grow-1 mx-2" style="max-width: 360px;">
            <span class="text-secondary small font-mono">0%</span>
            <input type="range" class="form-range flex-grow-1" min="0" max="100" value="100" id="rangeScrubberApuracao" style="height: 4px;" title="Navegar no tempo da apuração" />
            <span class="text-white fw-bold font-mono">100%</span>
        </div>

        <div class="d-flex align-items-center gap-2">
            <span class="text-secondary small"><i class="bi bi-people me-1"></i> Acompanhando agora:</span>
            <span class="badge bg-success text-white py-1 px-2 rounded-pill font-mono">
                <span class="pulse-nav me-1"></span> AO VIVO
            </span>
        </div>
    </div>

    <!-- Painel de Busca Instantânea Nacional (5.570+ Municípios + Exterior) -->
    <div class="mt-3 p-3 rounded-3" style="background: rgba(15, 23, 42, 0.7); border: 1px solid rgba(255, 255, 255, 0.08);">
        <div class="d-flex align-items-center justify-content-between mb-2 flex-wrap gap-2">
            <span class="small text-white fw-bold">
                <i class="bi bi-search me-1 text-primary"></i> Pesquisar Município ou Exterior:
            </span>
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle small">
                    5.570+ Cidades (Brasil & Exterior)
                </span>
            </div>
        </div>

        <div class="position-relative mb-2">
            <div class="input-group">
                <span class="input-group-text bg-dark border-secondary text-secondary"><i class="bi bi-search"></i></span>
                <input type="text" id="buscaGlobalMunicipioInput" class="form-control bg-dark text-white border-secondary" 
                       placeholder="Digite o nome de qualquer cidade (ex: Campinas, Belo Horizonte, Salvador, Lisboa, Miami...)" 
                       autocomplete="off" 
                       oninput="BuscaMunicipiosGlobal.pesquisar(this.value)"
                       onkeydown="BuscaMunicipiosGlobal.aoTeclar(event)" />
                <button class="btn btn-outline-secondary" type="button" onclick="BuscaMunicipiosGlobal.limpar()">Limpar</button>
            </div>

            <!-- Dropdown Flutuante de Resultados do Autocomplete -->
            <div id="dropdownResultadosMunicipios" 
                 class="position-absolute start-0 w-100 mt-1 rounded-3 shadow-lg p-2" 
                 style="display: none; max-height: 280px; overflow-y: auto; background: #0f172a; border: 1px solid rgba(255, 255, 255, 0.15); z-index: 1050; backdrop-filter: blur(16px);">
            </div>
        </div>

        <!-- Atalhos Rápidos da Localidade Selecionada (Capitais / Destaques) -->
        <div class="d-flex align-items-center justify-content-between mt-3 mb-1">
            <span class="text-secondary small fw-semibold" style="font-size: 0.75rem;">
                <i class="bi bi-pin-angle text-warning me-1"></i> Principais Cidades & Polos:
            </span>
            <span class="badge bg-secondary-subtle text-secondary small" id="lblTotalCidadesAtalhos">
                @Model.MunicipiosDisponiveis.Count cidades
            </span>
        </div>

        <div id="listaCidadesScroll" class="d-flex flex-wrap gap-2" style="max-height: 120px; overflow-y: auto;">
            <button type="button" 
                    class="btn btn-sm @(string.IsNullOrEmpty(Model.CodigoMunicipio) ? "btn-primary" : "btn-outline-secondary") py-1 px-2 small item-cidade-pill"
                    onclick="BuscaMunicipiosGlobal.selecionar('', '@Model.Uf')">
                <i class="bi bi-map-fill me-1"></i> @(Model.Uf == "br" ? "Brasil (Total Geral)" : $"Todo o Estado ({Model.Uf.ToUpperInvariant()})")
            </button>
            @foreach (var c in Model.MunicipiosDisponiveis.Take(60))
            {
                bool isSelected = Model.CodigoMunicipio == c.Codigo;
                <button type="button" 
                        class="btn btn-sm @(isSelected ? "btn-primary" : (c.Destaque ? "btn-outline-primary" : "btn-outline-secondary")) py-1 px-2 small item-cidade-pill"
                        onclick="BuscaMunicipiosGlobal.selecionar('@c.Codigo', '@(string.IsNullOrEmpty(c.Uf) ? Model.Uf : c.Uf.ToLowerInvariant())')">
                    @if (c.Destaque)
                    {
                        <i class="bi bi-star-fill text-warning me-1" style="font-size: 0.7rem;"></i>
                    }
                    @c.Nome
                    @if (!string.IsNullOrEmpty(c.Uf) && c.Uf != Model.Uf.ToUpperInvariant())
                    {
                        <span class="badge bg-secondary-subtle text-secondary ms-1" style="font-size: 0.65rem;">@c.Uf</span>
                    }
                </button>
            }
        </div>
    </div>
</div>

<!-- Modal Detalhado de Zonas Eleitorais do Município Clicado -->
<div class="modal fade" id="modalZonasEleitorais" tabindex="-1" aria-labelledby="modalZonasEleitoraisLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content text-white" style="background: #0f172a; border: 1px solid rgba(255, 255, 255, 0.15); box-shadow: 0 20px 40px rgba(0,0,0,0.8); backdrop-filter: blur(20px);">
            <div class="modal-header border-bottom border-secondary border-opacity-25 pb-3">
                <div class="d-flex align-items-center gap-2">
                    <div class="rounded-circle p-2 d-flex align-items-center justify-content-center" style="background: rgba(37, 99, 235, 0.15); color: #38bdf8;">
                        <i class="bi bi-geo-alt-fill fs-5"></i>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2">
                            <h5 class="modal-title fw-bold mb-0 text-white" id="modalMunNome">Campinas</h5>
                            <span class="badge bg-primary text-white font-mono" id="modalMunUf">SP</span>
                        </div>
                        <div class="small text-secondary" style="font-size: 0.75rem;">
                            Código TSE: <strong id="modalMunCod" class="font-mono text-white">62910</strong> • 100% das seções apuradas
                        </div>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-3">
                <!-- Placar Geral do Município -->
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <div class="p-3 rounded-3 text-center" style="background: rgba(196, 18, 45, 0.1); border: 1px solid rgba(196, 18, 45, 0.3);">
                            <div class="small fw-semibold text-danger mb-1">■ Lula (PT)</div>
                            <div class="fs-4 fw-bold font-mono text-white" id="modalPercCand1">46.5%</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 rounded-3 text-center" style="background: rgba(12, 50, 111, 0.15); border: 1px solid rgba(59, 130, 246, 0.3);">
                            <div class="small fw-semibold text-primary mb-1">■ Bolsonaro (PL)</div>
                            <div class="fs-4 fw-bold font-mono text-white" id="modalPercCand2">53.5%</div>
                        </div>
                    </div>
                </div>

                <!-- Tabela de Zonas Eleitorais -->
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="small fw-bold text-white text-uppercase">
                        <i class="bi bi-diagram-3-fill text-warning me-1"></i> Detalhamento por Zona Eleitoral:
                    </span>
                    <span class="small text-secondary" style="font-size: 0.72rem;">Distribuição de Votos por Cartório</span>
                </div>

                <div class="table-responsive rounded-2" style="border: 1px solid rgba(255, 255, 255, 0.08);">
                    <table class="table table-dark table-hover mb-0 align-middle" style="font-size: 0.8rem;">
                        <thead class="text-secondary small">
                            <tr>
                                <th>Zona</th>
                                <th>Seções</th>
                                <th>Eleitorado</th>
                                <th>Lula (PT)</th>
                                <th>Bolsonaro (PL)</th>
                            </tr>
                        </thead>
                        <tbody id="modalTabelaZonasBody">
                            <!-- Inserido dinamicamente pelo Leaflet -->
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer border-top border-secondary border-opacity-25 py-2 d-flex justify-content-between">
                <span class="small text-secondary" style="font-size: 0.72rem;">
                    <i class="bi bi-shield-check text-success me-1"></i> Dados oficiais de totalização da Justiça Eleitoral
                </span>
                <button type="button" class="btn btn-sm btn-primary px-3 rounded-pill" id="btnModalAbrirApuracaoMun">
                    <i class="bi bi-box-arrow-up-right me-1"></i> Ver Página Completa Deste Município
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    const BuscaMunicipiosGlobal = {
        indice: null,
        indiceCarregando: false,
        indiceIndexado: [],
        selecionadoIndex: -1,

        normalizar(str) {
            if (!str) return '';
            return str.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").trim();
        },

        async carregar() {
            if (this.indice) return this.indice;
            if (this.indiceCarregando) return null;
            this.indiceCarregando = true;
            try {
                const res = await fetch('/data/municipios.json');
                if (!res.ok) throw new Error("Erro ao carregar lista de municípios");
                const data = await res.json();
                this.indice = data;
                // Precomputar nomes normalizados para busca ultra-rápida
                this.indiceIndexado = data.map(item => ({
                    cod: item[0],
                    uf: item[1],
                    nome: item[2],
                    cap: item[3],
                    nomeNorm: this.normalizar(item[2]),
                    ufNorm: item[1].toLowerCase()
                }));
                this.indiceCarregando = false;
                return this.indice;
            } catch (e) {
                console.error(e);
                this.indiceCarregando = false;
                return null;
            }
        },

        async pesquisar(valor) {
            const dropdown = document.getElementById("dropdownResultadosMunicipios");
            if (!dropdown) return;

            const q = this.normalizar(valor);
            if (!q || q.length < 2) {
                dropdown.style.display = 'none';
                dropdown.innerHTML = '';
                this.selecionadoIndex = -1;
                return;
            }

            await this.carregar();
            if (!this.indiceIndexado || !this.indiceIndexado.length) return;

            // Filtragem rápida
            const matches = [];
            for (let i = 0; i < this.indiceIndexado.length; i++) {
                const item = this.indiceIndexado[i];
                if (item.nomeNorm.includes(q) || item.cod === q) {
                    matches.push(item);
                    if (matches.length >= 25) break; // Máximo 25 sugestões instantâneas
                }
            }

            if (matches.length === 0) {
                dropdown.innerHTML = `
                    <div class="p-3 text-center text-secondary small">
                        <i class="bi bi-geo-alt-fill text-muted me-1"></i> Nenhuma cidade encontrada para "<strong>${valor}</strong>".
                    </div>
                `;
                dropdown.style.display = 'block';
                return;
            }

            this.selecionadoIndex = -1;
            let html = '<div class="list-group list-group-flush">';
            matches.forEach((m, idx) => {
                const isExterior = m.uf === 'ZZ';
                const badgeUf = isExterior 
                    ? '<span class="badge bg-info-subtle text-info border border-info-subtle">Exterior</span>' 
                    : `<span class="badge bg-primary-subtle text-primary border border-primary-subtle">${m.uf}</span>`;
                const star = m.cap ? '<i class="bi bi-star-fill text-warning ms-1" title="Capital"></i>' : '';

                html += `
                    <div class="list-group-item list-group-item-action bg-transparent text-white border-0 rounded-2 py-2 px-3 d-flex align-items-center justify-content-between item-sugestao-mun"
                         data-index="${idx}"
                         style="cursor: pointer; transition: background 0.15s ease;"
                         onmouseover="this.style.background='rgba(59, 130, 246, 0.2)'"
                         onmouseout="this.style.background='transparent'"
                         onclick="BuscaMunicipiosGlobal.selecionar('${m.cod}', '${m.uf.toLowerCase()}')">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-geo-alt text-secondary"></i>
                            <span class="fw-medium">${m.nome}</span>
                            ${star}
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="small font-mono text-secondary" style="font-size: 0.72rem;">Cód: ${m.cod}</span>
                            ${badgeUf}
                        </div>
                    </div>
                `;
            });
            html += '</div>';

            dropdown.innerHTML = html;
            dropdown.style.display = 'block';
        },

        aoTeclar(event) {
            const dropdown = document.getElementById("dropdownResultadosMunicipios");
            if (!dropdown || dropdown.style.display === 'none') return;

            const itens = dropdown.querySelectorAll('.item-sugestao-mun');
            if (!itens.length) return;

            if (event.key === 'ArrowDown') {
                event.preventDefault();
                this.selecionadoIndex = Math.min(this.selecionadoIndex + 1, itens.length - 1);
                this.destacarItem(itens);
            } else if (event.key === 'ArrowUp') {
                event.preventDefault();
                this.selecionadoIndex = Math.max(this.selecionadoIndex - 1, 0);
                this.destacarItem(itens);
            } else if (event.key === 'Enter') {
                event.preventDefault();
                if (this.selecionadoIndex >= 0 && this.selecionadoIndex < itens.length) {
                    itens[this.selecionadoIndex].click();
                } else if (itens.length > 0) {
                    itens[0].click();
                }
            } else if (event.key === 'Escape') {
                this.limpar();
            }
        },

        destacarItem(itens) {
            itens.forEach((el, i) => {
                if (i === this.selecionadoIndex) {
                    el.style.background = 'rgba(59, 130, 246, 0.35)';
                    el.scrollIntoView({ block: 'nearest' });
                } else {
                    el.style.background = 'transparent';
                }
            });
        },

        limpar() {
            const input = document.getElementById("buscaGlobalMunicipioInput");
            if (input) input.value = '';
            const dropdown = document.getElementById("dropdownResultadosMunicipios");
            if (dropdown) {
                dropdown.style.display = 'none';
                dropdown.innerHTML = '';
            }
            this.selecionadoIndex = -1;
        },

        selecionar(codigo, uf) {
            const url = new URL(window.location.href);
            url.searchParams.set('ano', '@Model.Ano');
            url.searchParams.set('cargo', '@Model.CargoCodigo');
            
            if (uf) {
                url.searchParams.set('uf', uf.toLowerCase());
            }

            if (codigo) {
                url.searchParams.set('municipio', codigo);
            } else {
                url.searchParams.delete('municipio');
            }

            window.location.href = url.toString();
        }
    };

    // Fechar dropdown ao clicar fora
    document.addEventListener('click', (e) => {
        const box = document.getElementById('buscaGlobalMunicipioInput');
        const dropdown = document.getElementById('dropdownResultadosMunicipios');
        if (dropdown && box && !box.contains(e.target) && !dropdown.contains(e.target)) {
            dropdown.style.display = 'none';
        }
    });

    // Pré-carregar o índice em background após o carregamento da página
    if (window.requestIdleCallback) {
        window.requestIdleCallback(() => BuscaMunicipiosGlobal.carregar());
    } else {
        setTimeout(() => BuscaMunicipiosGlobal.carregar(), 1500);
    }
</script>